// Wrangler reads this file itself, so the deployment target cannot be injected
// from site.config.json. The Worker name and the custom domain are mirrored
// from it instead, and `ctcdocs-sync validate` fails if the two disagree.
// Change the configuration first, then this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-docs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "docs.example.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
