{
  "access": {
    "admins": ["docs-admins@example.com"],
    "rules": [
      {
        "folder": "folder-handbook",
        "label": "01 - Handbook",
        "readers": ["*"]
      },
      {
        "folder": "folder-reference",
        "label": "Reference",
        "readers": ["engineering@example.com", "writers@example.com"]
      },
      {
        "folder": "folder-reference-guides",
        "label": "Style guides",
        "readers": ["designers@example.com", "writers@example.com"]
      },
      {
        "folder": "folder-drafts",
        "label": "Drafts",
        "readers": ["*"]
      }
    ]
  },
  "signIn": {
    "workspaceDomains": ["example.com"]
  },
  "mcp": {
    "enabled": true
  },
  "brand": {
    "name": "Example Corp",
    "siteTitle": "Example [DOCS]",
    "siteDescription": "Synthetic documentation used to test the CTCDocs platform",
    "faviconPath": "/favicon.svg"
  },
  "deployment": {
    "workerName": "example-docs",
    "environments": {
      "production": {
        "url": "https://docs.example.com"
      }
    }
  },
  "home": {
    "lede": "Every document here is published from Google Docs in the Example Shared Drive and is read-only. Each entry shows when its source was last edited.",
    "recentLimit": 3,
    "corpusIndex": false
  },
  "navigation": {
    "landingDocumentTitles": ["Overview", "README", "About"],
    "sectionIndexPages": true
  },
  "sync": {
    "generatedBy": "CTCDOCS SYNC",
    "commitBotName": "ctcdocs-sync[bot]",
    "defaultLocale": "en"
  }
}
