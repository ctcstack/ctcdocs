{
  "name": "ctcdocs-fixture-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A complete CTCDocs project with a synthetic corpus. Platform CI builds and tests it the way a real deployment would.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "validate": "ctcdocs-sync validate",
    "test:search": "ctcdocs-verify-search",
    "test:ux": "playwright test --config playwright.ux.config.ts",
    "deploy:dry-run": "wrangler deploy --env production --dry-run"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.5",
    "@ctcstack/ctcdocs": "workspace:*",
    "@ctcstack/ctcdocs-sync": "workspace:*",
    "astro": "7.1.6",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  }
}
