{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(actionlint:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git status:*)",
      "Bash(gitleaks:*)",
      "Bash(lychee:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm deploy:dry-run:*)",
      "Bash(pnpm fixtures:*)",
      "Bash(pnpm format:check:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm knip:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm test:coverage:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm verify:*)",
      "Bash(zizmor:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh workflow run:*)",
      "Bash(pnpm sync:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/*.local)",
      "Read(./gha-creds-*.json)",
      "Bash(wrangler deploy:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Edit(./fixtures/project/src/content/docs/_generated/**)",
      "Write(./fixtures/project/src/content/docs/_generated/**)",
      "Edit(./fixtures/project/src/assets/generated/**)",
      "Write(./fixtures/project/src/assets/generated/**)",
      "Edit(./fixtures/project/src/generated/**)",
      "Write(./fixtures/project/src/generated/**)",
      "Edit(./fixtures/project/data/**)",
      "Write(./fixtures/project/data/**)"
    ]
  }
}
