{
  "name": "ctcdocs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "build": "pnpm --filter @ctcstack/ctcdocs-core build && pnpm --filter @ctcstack/ctcdocs-sync build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run && node --test packages/astro/bin/*.test.mjs",
    "test:coverage": "vitest run --coverage && node --test packages/astro/bin/*.test.mjs",
    "knip": "knip",
    "prepare": "husky",
    "verify:staged": "lint-staged",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test:coverage && pnpm fixtures:check && pnpm fixtures:build && pnpm fixtures:validate && pnpm fixtures:deploy-dry-run && pnpm fixtures:search && pnpm fixtures:ux && pnpm knip",
    "fixtures:generate": "node fixtures/generate-corpus.ts",
    "fixtures:check": "node fixtures/verify-corpus.mjs",
    "fixtures:build": "pnpm --filter ctcdocs-fixture-project build",
    "fixtures:validate": "pnpm --filter ctcdocs-fixture-project validate",
    "fixtures:search": "pnpm --filter ctcdocs-fixture-project test:search",
    "fixtures:ux": "pnpm --filter ctcdocs-fixture-project test:ux",
    "fixtures:deploy-dry-run": "pnpm --filter ctcdocs-fixture-project deploy:dry-run"
  },
  "devDependencies": {
    "@ctcstack/ctcdocs-core": "workspace:*",
    "@ctcstack/ctcdocs-sync": "workspace:*",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
