# Node tooling
node_modules/
.astro/
coverage/

# Build output is ignored everywhere except in the packages, where it is
# committed: projects install them from Git until the npm scope exists, and a
# Git dependency that has to run a build script needs an allowlist entry keyed
# by its exact commit — which no automated bump can keep current. CI rebuilds
# and fails on any diff.
dist/
!packages/*/dist/

# Versioned Git hook definitions (Husky runtime files remain ignored)
!.husky/
!.husky/pre-commit

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/

# Claude Code: shared project configuration is versioned, local overrides are not
.claude/settings.local.json
.claude/*.local.json

# OS
.DS_Store

# Logs
*.log

# Test and build artifacts
playwright-report/
test-results/
blob-report/
.playwright-browsers/
.tmp/
.wrangler/

# Temporary Google credentials generated by CI auth actions
gha-creds-*.json

# Local state written by the "impeccable" design tooling
.impeccable/

# Compiled Node entrypoints of the site package, committed for the same reason
dist-node/
!packages/astro/dist-node/
