{
  "name": "@ctcstack/ctcdocs-sync",
  "version": "0.20.0",
  "description": "One-way Google Drive to Markdown synchronization for CTCDocs projects, with the ctcdocs-sync command line.",
  "keywords": [
    "google-drive",
    "google-docs",
    "markdown",
    "documentation",
    "docs-as-code",
    "static-site",
    "sync"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctcstack/ctcdocs.git",
    "directory": "packages/sync"
  },
  "homepage": "https://github.com/ctcstack/ctcdocs/tree/main/packages/sync#readme",
  "bugs": {
    "url": "https://github.com/ctcstack/ctcdocs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ctcdocs-sync": "./bin/ctcdocs-sync.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-support"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@ctcstack/ctcdocs-core": "workspace:^",
    "cheerio": "1.2.0",
    "domhandler": "5.0.3",
    "fast-png": "8.0.0",
    "htmlparser2": "10.1.0",
    "jsonc-parser": "3.3.1",
    "numfmt": "3.2.6",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "smol-toml": "1.9.0",
    "turndown": "7.2.4",
    "unified": "11.0.5",
    "unpdf": "1.8.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.1",
    "@types/turndown": "5.0.6",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
