{
  "name": "@ctcstack/ctcdocs-core",
  "version": "0.17.0",
  "description": "Configuration schema, project layout, generated-path allowlist and the published Markdown form shared by the CTCDocs platform packages.",
  "keywords": [
    "ctcdocs",
    "configuration",
    "documentation",
    "astro",
    "starlight"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctcstack/ctcdocs.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ctcstack/ctcdocs/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ctcstack/ctcdocs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./published-markdown": {
      "types": "./dist/published-markdown.d.ts",
      "default": "./dist/published-markdown.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
