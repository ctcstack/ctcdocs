{
  "name": "@ctcstack/ctcdocs-core",
  "version": "0.1.0",
  "description": "Configuration schema, project layout, and generated-path allowlist shared by the CTCDocs platform packages.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctcstack/ctcdocs.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --root ../.."
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "fast-check": "4.9.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
