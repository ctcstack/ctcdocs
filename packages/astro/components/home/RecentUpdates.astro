---
/**
 * What changed across the whole corpus, most recent first.
 *
 * This answers a different question from the folder views around it. They are
 * grouped by folder and answer "what exists here"; this answers "what has
 * moved since I last looked", which no folder view can show.
 *
 * How far back the band reaches is the project's decision rather than this
 * component's, because it follows the corpus: the same six rows are a fortnight
 * on one deployment and an afternoon on another.
 */
import { formatDate, type CorpusDocument } from '../../lib/corpus';

type Props = { documents: CorpusDocument[]; limit: number };

/** A document that carries a source modification time. */
type DatedDocument = CorpusDocument & { modified: Date };

const { documents, limit } = Astro.props;

// Undated documents are omitted here rather than shown without an age: this
// band exists to answer "what moved recently", which they cannot answer. They
// remain listed in the full index, and in their folder either way.
const recent = documents
  .filter((doc): doc is DatedDocument => doc.modified !== undefined)
  .slice(0, limit);
---

{
  recent.length > 0 && (
    <section aria-labelledby="home-recent" class="recent">
      <h2 class="section-title" id="home-recent">
        Recently updated
      </h2>

      <ul class="recent-list">
        {recent.map((doc) => (
          <li>
            <a href={doc.href}>
              <span class="recent-title">
                <svg
                  aria-hidden="true"
                  class="recent-icon"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  viewBox="0 0 16 16"
                >
                  <path d="M9 2H4.5A1.5 1.5 0 0 0 3 3.5v9A1.5 1.5 0 0 0 4.5 14h7a1.5 1.5 0 0 0 1.5-1.5V6z" />
                  <path d="M9 2v4h4" />
                </svg>
                {doc.title}
              </span>
              <span class="recent-folder">{doc.folder}</span>
              <relative-date class="recent-date">
                <time datetime={doc.modified.toISOString()}>
                  {formatDate(doc.modified)}
                </time>
              </relative-date>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<script>
  import '../../scripts/relative-date';
</script>

<style>
  /*
   * Unlayered on purpose, and for the reason the folder cards carry the same
   * reset: this block renders inside Starlight's markdown container, whose
   * `li + li` rule adds a top margin to every item after the first. On a ruled
   * list that margin falls above the row's own border — between a row's text
   * and the line under it — so every row read as bottom-heavy by exactly that
   * margin. Outranking a layered stylesheet takes an unlayered rule.
   */
  .recent-list > li {
    margin: 0;
  }

  @layer starlight.components {
    .recent {
      margin-top: 3rem;
    }

    .recent-list {
      border-top: 1px solid var(--sl-color-hairline);
      list-style: none;
      margin: 1.25rem 0 0;
      padding: 0;
    }

    .recent-list li + li {
      border-top: 1px solid var(--sl-color-hairline);
    }

    /*
     * The whole row is one size, so scale and leading are declared once here
     * rather than on each part. Both are set rather than inherited: the prose
     * values are meant for paragraphs and left a row standing 47px tall for
     * 14px of text. A row is one line of a record, so it takes the table's
     * leading and the padding closes to match.
     */
    .recent-list a {
      align-items: baseline;
      column-gap: 1rem;
      display: flex;
      flex-wrap: wrap;
      font-size: var(--sl-text-sm);
      line-height: var(--sl-line-height-table);
      padding: 0.5rem 0;
      text-decoration: none;
    }

    /*
     * A row names a document, so it is set as a record rather than as prose:
     * one step below reading size, with the same glyph the folder cards use.
     * The name still outranks the folder and the date beside it, but on tone
     * rather than on scale, which is what lets three columns share one line
     * without the row reading as a paragraph.
     *
     * The negative indent with matching padding hangs a wrapped title under
     * its own first character instead of under the glyph.
     */
    .recent-title {
      color: var(--sl-color-white);
      flex: 1 1 18ch;
      padding-inline-start: 1.375rem;
      text-indent: -1.375rem;
      text-wrap: pretty;
    }

    /* The theme sets `svg { display: block }`, which would break the line. */
    .recent-icon {
      color: var(--sl-color-gray-3);
      display: inline-block;
      height: 0.875rem;
      margin-inline-end: 0.5rem;
      vertical-align: -0.0625em;
      width: 0.875rem;
    }

    .recent-list a:hover :is(.recent-title, .recent-icon) {
      color: var(--sl-color-text-accent);
    }

    .recent-list a:focus-visible {
      border-radius: 0.25rem;
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 2px;
    }

    .recent-folder {
      color: var(--sl-color-gray-3);
    }

    .recent-date {
      color: var(--sl-color-gray-3);
      font-variant-numeric: tabular-nums;
      text-align: end;
      white-space: nowrap;
    }

    @media (min-width: 30rem) {
      .recent-date {
        flex: 0 0 8.5rem;
      }
    }

    /* Freshness carries rank here as it does in the index. */
    .recent-date[data-age='fresh'] {
      color: var(--sl-color-white);
      font-weight: 500;
    }

    .recent-date[data-age='recent'] {
      color: var(--sl-color-gray-2);
    }
  }
</style>
