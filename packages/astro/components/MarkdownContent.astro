---
/**
 * Overrides Starlight's `MarkdownContent`.
 *
 * Every page renders exactly as Starlight renders it, except a section page
 * whose frontmatter records its entries: that one draws the listing with
 * folders and documents told apart, instead of the plain Markdown list in its
 * body. The Markdown list is the fallback whenever the entries cannot be drawn,
 * so a page generated before they existed still reads correctly.
 *
 * See docs/ADR/019-folders-before-documents.md.
 */
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { getCollection } from 'astro:content';

import PdfFile from './PdfFile.astro';
import SectionListing from './SectionListing.astro';
import { classOfDocument, classOfFolderSlug } from '../lib/access-source';
import { sectionListingRows, type ListedPage } from '../lib/section-listing';

const { entry } = Astro.locals.starlightRoute;

async function loadRows() {
  if (entry.data.sourceType !== 'section-index' || !entry.data.entries) {
    return undefined;
  }
  const docs = await getCollection('docs');
  /*
   * A document whose move waits for a rule has fewer readers than this page
   * (ADR-039), so it is listed by title alone: its description is its text.
   */
  const pageClass = classOfFolderSlug(entry.id);
  const pages = new Map<string, ListedPage>(
    docs.map((doc) => [
      doc.id,
      {
        sourceType: doc.data.sourceType,
        title: doc.data.title,
        description:
          doc.data.sourceType === 'section-index' ||
          classOfDocument(doc.data.googleFileId) === pageClass
            ? doc.data.description
            : undefined,
        googleModifiedTime: doc.data.googleModifiedTime,
      },
    ]),
  );
  return sectionListingRows(entry.data.entries, pages);
}

const rows = await loadRows();

/*
 * A PDF's page (ADR-027) shows the file first, and its text below, folded
 * while the file is there to read. Search indexes the text either way.
 */
const { pdf, googleFileId, editUrl, title } = entry.data;
const pdfText = Boolean(entry.body?.trim());
---

<Default>
  {
    pdf && googleFileId && (
      <PdfFile
        googleFileId={googleFileId}
        title={title}
        file={pdf.file}
        bytes={pdf.bytes}
        pages={pdf.pages}
        sourceUrl={typeof editUrl === 'string' ? editUrl : undefined}
      />
    )
  }
  {
    rows ? (
      <SectionListing rows={rows} />
    ) : pdf && pdfText ? (
      <details class="pdf-text" open={!pdf.file}>
        <summary>Text of the PDF</summary>
        <slot />
      </details>
    ) : (
      <slot />
    )
  }
</Default>

<style>
  @layer starlight.components {
    .pdf-text > summary {
      cursor: pointer;
      font-weight: 600;
      margin-block-end: 1rem;
    }
  }
</style>
