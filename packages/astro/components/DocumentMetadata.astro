---
/**
 * Source provenance for a synchronized document.
 *
 * Rendered directly under the title rather than in the page footer: a reader
 * needs to know how fresh a document is before reading it, not after. Recorded
 * in docs/ADR/011-documentation-design-language.md.
 *
 * Freshness is reported from `googleModifiedTime` — when a person last edited
 * the source — not from `syncedAt`, which changes on every pipeline run and
 * tells a reader nothing. The exact sync time stays available in the tooltip.
 */
const { entry } = Astro.locals.starlightRoute;
const { editUrl, googleModifiedTime, sourceType, syncedAt } = entry.data;

const sourceUrl = typeof editUrl === 'string' ? editUrl : undefined;
const markdownUrl = `/${entry.id}/index.md`;

function formatUtcDate(value: string): string {
  return new Date(value).toLocaleDateString('en', {
    day: 'numeric',
    month: 'short',
    timeZone: 'UTC',
    year: 'numeric',
  });
}

function formatUtcDateTime(value: string): string {
  return new Date(value).toLocaleString('en', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'UTC',
  });
}

const showMetadata =
  sourceType === 'google-doc' && sourceUrl && googleModifiedTime && syncedAt;
---

{
  showMetadata && (
    <div class="doc-meta" data-pagefind-ignore>
      <span class="doc-meta-fact">
        <svg
          aria-hidden="true"
          class="doc-meta-icon"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 16 16"
        >
          <circle cx="8" cy="8" r="6" />
          <path d="M8 4.5V8l2.5 1.5" />
        </svg>
        Updated{' '}
        <relative-date>
          <time
            datetime={googleModifiedTime}
            title={`Synced ${formatUtcDateTime(syncedAt)} UTC`}
          >
            {formatUtcDate(googleModifiedTime)}
          </time>
        </relative-date>
      </span>

      <span aria-hidden="true" class="doc-meta-divider" />

      <copy-markdown data-source={markdownUrl}>
        <button class="doc-meta-action" type="button">
          <svg
            aria-hidden="true"
            class="doc-meta-icon"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.5"
            viewBox="0 0 16 16"
          >
            <rect height="7.5" rx="1.5" width="7.5" x="6" y="6" />
            <path d="M10 6V4a1.5 1.5 0 0 0-1.5-1.5h-4A1.5 1.5 0 0 0 3 4v4a1.5 1.5 0 0 0 1.5 1.5H6" />
          </svg>
          <span data-copy-label>Copy as Markdown</span>
        </button>
        <span class="doc-meta-status" data-copy-status role="status" />
      </copy-markdown>

      <a class="doc-meta-action" href={markdownUrl}>
        <svg
          aria-hidden="true"
          class="doc-meta-icon"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 16 16"
        >
          <path d="M9 2H4.5A1.5 1.5 0 0 0 3 3.5v9A1.5 1.5 0 0 0 4.5 14h7a1.5 1.5 0 0 0 1.5-1.5V6z" />
          <path d="M9 2v4h4" />
        </svg>
        View as Markdown
      </a>

      <a
        class="doc-meta-action"
        href={sourceUrl}
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg
          aria-hidden="true"
          class="doc-meta-icon"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.5"
          viewBox="0 0 16 16"
        >
          <path d="M9.5 3H13v3.5" />
          <path d="M13 3 8 8" />
          <path d="M12 9.5v3A1.5 1.5 0 0 1 10.5 14h-7A1.5 1.5 0 0 1 2 12.5v-7A1.5 1.5 0 0 1 3.5 4h3" />
        </svg>
        Open in Google Docs
      </a>
    </div>
  )
}

<script>
  import '../scripts/relative-date';

  /**
   * Copies the document's Markdown projection to the clipboard.
   *
   * The projection route is the same one `View as Markdown` opens, so the
   * clipboard and the link never disagree. Failures are reported in place
   * rather than swallowed: the reader can still use the link.
   */
  class CopyMarkdown extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const label = this.querySelector<HTMLElement>('[data-copy-label]');
      const status = this.querySelector<HTMLElement>('[data-copy-status]');
      const source = this.dataset.source;

      if (!button || !label || !status || !source) return;

      // Without the async clipboard API the link beside this button still works.
      if (!navigator.clipboard) {
        this.hidden = true;
        return;
      }

      const idle = label.textContent ?? 'Copy as Markdown';
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      button.addEventListener('click', async () => {
        clearTimeout(resetTimer);
        try {
          const response = await fetch(source);
          if (!response.ok)
            throw new Error(`Request failed: ${response.status}`);
          await navigator.clipboard.writeText(await response.text());
          label.textContent = 'Copied';
          status.textContent = 'Markdown copied to clipboard';
          this.dataset.state = 'copied';
        } catch {
          label.textContent = 'Copy failed';
          status.textContent = 'Could not copy. Use View as Markdown instead.';
          this.dataset.state = 'failed';
        }
        resetTimer = setTimeout(() => {
          label.textContent = idle;
          status.textContent = '';
          delete this.dataset.state;
        }, 4000);
      });
    }
  }

  customElements.define('copy-markdown', CopyMarkdown);
</script>

<style>
  @layer starlight.components {
    /*
     * A hairline closes the header block off from the document body, in the
     * same tone as every other divider on the page. The reference hides this
     * rule below its wide breakpoint; here it holds at every width, because
     * the row wraps to two lines on a phone and needs the separation more,
     * not less.
     */
    .doc-meta {
      align-items: center;
      border-bottom: 1px solid var(--sl-color-hairline);
      color: var(--sl-color-gray-3);
      column-gap: 1rem;
      display: flex;
      flex-wrap: wrap;
      font-size: var(--sl-text-sm);
      padding-bottom: 0.75rem;
      row-gap: 0.5rem;
    }

    /*
     * The freshness fact is the reason this row sits above the text, so it
     * takes ink weight while the actions beside it stay muted. Without that
     * step one statement and three controls read as four identical links.
     */
    .doc-meta-fact {
      align-items: center;
      color: var(--sl-color-white);
      display: inline-flex;
      gap: 0.4rem;
      white-space: nowrap;
    }

    .doc-meta-divider {
      align-self: stretch;
      border-inline-start: 1px solid var(--sl-color-hairline);
      margin-inline: -0.25rem;
    }

    .doc-meta-icon {
      flex-shrink: 0;
      height: 1em;
      width: 1em;
    }

    .doc-meta-action {
      align-items: center;
      background: none;
      border: 0;
      color: var(--sl-color-gray-3);
      cursor: pointer;
      display: inline-flex;
      font: inherit;
      gap: 0.4rem;
      padding: 0;
      text-decoration: none;
      white-space: nowrap;
    }

    .doc-meta-action:hover {
      color: var(--sl-color-text-accent);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .doc-meta-action:focus-visible {
      border-radius: 0.25rem;
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 3px;
    }

    copy-markdown {
      align-items: center;
      display: inline-flex;
      gap: 0.4rem;
    }

    copy-markdown[data-state='copied'] .doc-meta-action {
      color: var(--sl-color-text-accent);
    }

    copy-markdown[data-state='failed'] .doc-meta-action {
      color: var(--sl-color-red-high);
    }

    /*
     * The status text is announced but not shown: the button's own label
     * already reports the outcome visually.
     */
    .doc-meta-status {
      clip-path: inset(50%);
      height: 1px;
      overflow: hidden;
      position: absolute;
      white-space: nowrap;
      width: 1px;
    }
  }
</style>
