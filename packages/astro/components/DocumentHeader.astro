---
/**
 * Overrides Starlight's `PageTitle`.
 *
 * The document opens with its position, its name, and its provenance, in that
 * order — the reference arrangement recorded in
 * docs/ADR/011-documentation-design-language.md.
 *
 * A breadcrumb segment links to that folder's own page. Where a folder has
 * none — the section pages are switched off — the top segment falls back to
 * that folder's group on the home index, which lists the whole corpus, and
 * deeper segments stay as context.
 */
import DocumentMetadata from './DocumentMetadata.astro';
import { folderAnchorHref, folderTrail } from '../lib/folder-anchor';
import { loadSectionHrefs, sectionHref } from '../lib/sections';

// Starlight's PAGE_TITLE_ID. It is the skip link's target and is not exported.
const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const { folderPath, title } = entry.data;

const trail = folderTrail(folderPath);
const sections = await loadSectionHrefs();
const segments = trail.map((folder, index) => ({
  folder,
  href:
    sectionHref(sections, trail.slice(0, index + 1)) ??
    (index === 0 ? folderAnchorHref(folder) : undefined),
}));

/*
 * Every document page gets a trail, including documents at the Drive root:
 * they have no folder segments but still need the way back. The splash layout
 * is the home index itself, which is where the trail leads.
 */
const showBreadcrumb = entry.data.template !== 'splash';
---

{
  showBreadcrumb && (
    <nav
      aria-label="Breadcrumb"
      class="doc-breadcrumb"
      data-ctcdocs-unindexed="breadcrumb"
      data-pagefind-ignore
    >
      <ol>
        <li>
          <a href="/">Home</a>
        </li>
        {segments.map((segment) => (
          <li>
            {segment.href ? (
              <a href={segment.href}>{segment.folder}</a>
            ) : (
              <span>{segment.folder}</span>
            )}
          </li>
        ))}
        {/* No leaf segment: the heading directly below is the current page,
            and repeating it here says the same thing twice. */}
      </ol>
    </nav>
  )
}

<h1 id={PAGE_TITLE_ID}>{title}</h1>

<DocumentMetadata />

<style>
  @layer starlight.core {
    /*
     * Qualified by the content panel so the title sits close under the trail:
     * the panel's own `.sl-container > * + *` spacing is in this layer too,
     * and a bare `h1` loses to it on specificity.
     */
    :global(.sl-container) > h1 {
      color: var(--kb-ink);
      font-size: var(--kb-text-h1);
      font-weight: 600;
      letter-spacing: -0.025em;
      line-height: var(--kb-line-height-headings);
      margin-top: 1rem;
      text-wrap: balance;
    }

    /*
     * A step smaller than the metadata row and a step heavier than body text:
     * the trail reads as navigation, apart from the document, without losing
     * its place. The title keeps a full line of space below it.
     */
    .doc-breadcrumb {
      font-size: var(--kb-text-xs);
      font-weight: 500;
      letter-spacing: 0.005em;
    }

    .doc-breadcrumb ol {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.375rem;
      list-style: none;
      padding: 0;
    }

    .doc-breadcrumb li {
      align-items: center;
      display: inline-flex;
    }

    /*
     * The separator is decorative and generated, so it is never selected,
     * announced, or copied along with the trail. It shares the trail's tone
     * rather than a fainter one: at this size a lighter gray fell below the
     * contrast floor in the light theme. It is a thin chevron, which reads
     * as "inside" where a slash reads as a file path.
     */
    .doc-breadcrumb li + li::before {
      background-color: var(--kb-gray-3);
      content: '';
      display: inline-block;
      height: 0.875em;
      margin-inline-end: 0.375rem;
      mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m9 6 6 6-6 6'/></svg>")
        center / contain no-repeat;
      width: 0.875em;
    }

    /*
     * The whole trail sits at one muted tone. The leaf repeats the heading
     * directly below it, so nothing here competes with the title for weight.
     */
    .doc-breadcrumb a,
    .doc-breadcrumb span {
      color: var(--kb-gray-3);
      text-decoration: none;
    }

    .doc-breadcrumb a:hover {
      color: var(--kb-text-accent);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }

  /* Starlight spaces siblings inside the content panel; the header is one unit. */
  @layer starlight.core {
    h1,
    .doc-breadcrumb {
      margin-bottom: 0;
    }
  }
</style>
