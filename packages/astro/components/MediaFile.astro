---
/**
 * The recording a video or audio file's page describes (ADR-047).
 *
 * The site does not host or play recordings: this links to the file where it
 * plays, in Google Drive or Google Vids, whose own sharing decides who may
 * play it. The text below the card says what Drive knows about the file,
 * its length included, so the card does not repeat it.
 */
interface Props {
  kind: 'video' | 'audio';
  /** A Google Vids video, which plays in Google Vids rather than Drive. */
  vids: boolean;
  sourceUrl: string;
}

const { kind, vids, sourceUrl } = Astro.props;
const action = `${kind === 'audio' ? 'Listen' : 'Watch'} in ${vids ? 'Google Vids' : 'Google Drive'}`;
---

<section
  class="media-file"
  aria-label={kind === 'audio' ? 'Audio recording' : 'Video'}
  data-ctcdocs-unindexed="media-file"
  data-pagefind-ignore
>
  <svg
    aria-hidden="true"
    class="media-icon"
    fill="none"
    stroke="currentColor"
    stroke-linejoin="round"
    stroke-width="1.5"
    viewBox="0 0 24 24"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <path d="M10 8.5v7l6-3.5z" fill="currentColor"></path>
  </svg>
  <a
    class="media-action"
    href={sourceUrl}
    rel="noopener noreferrer"
    target="_blank">{action}</a
  >
</section>

<style>
  @layer starlight.components {
    .media-file {
      align-items: center;
      border: 1px solid var(--kb-hairline);
      border-radius: 0.5rem;
      display: flex;
      gap: 1rem;
      margin-block: 1rem 1.5rem;
      padding: 1rem 1.25rem;
    }

    .media-icon {
      color: var(--kb-text-accent);
      flex: none;
      height: 2.5rem;
      width: 2.5rem;
    }

    .media-action {
      font-weight: 600;
    }
  }
</style>
