---
/**
 * The mark and the site's name in the header. The mark is the project's own
 * icon, `brand.faviconPath` in its configuration, so one file names the site
 * in the tab and in the header. Its shape is the file's own: the stylesheet
 * sets its height and the width follows.
 */
import { siteConfiguration } from '../lib/project';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const mark = siteConfiguration.brand.faviconPath;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <img src={mark} alt="" />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      color: var(--kb-text-accent);
      font-size: var(--kb-text-h4);
      font-weight: 600;
      gap: var(--kb-nav-gap);
      min-width: 0;
      text-decoration: none;
      white-space: nowrap;
    }

    img {
      height: calc(var(--kb-nav-height) - 2 * var(--kb-nav-pad-y));
      object-fit: contain;
      width: auto;
    }

    span {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
