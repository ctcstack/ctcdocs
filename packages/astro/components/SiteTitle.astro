---
/**
 * The mark and the site's name in the header. The mark is the project's own
 * icon, `brand.faviconPath` in its configuration, so one file names the site
 * in the tab and in the header. Where the project also draws it for a dark
 * ground, `brand.faviconDarkPath`, the header shows that one under the dark
 * theme the reader chose on the site, whatever their system's setting. Its
 * shape is the file's own: the stylesheet sets its height and the width
 * follows.
 *
 * On a wide screen a button before the mark hides and shows the sidebar. The
 * choice is the reader's and is kept in their browser; Head.astro applies it
 * before the page paints, so a hidden sidebar does not flash on navigation.
 * On a narrow screen the sidebar is Starlight's menu and the button is not
 * drawn.
 *
 * After the name, a project that lists its organization's other sites gets
 * the switcher between them (SiteSwitcher.astro).
 */
import { siteConfiguration } from '../lib/project';
import SiteSwitcher from './SiteSwitcher.astro';
import ThemedMark from './ThemedMark.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const { faviconPath, faviconDarkPath } = siteConfiguration.brand;
---

<button
  type="button"
  class="kb-sidebar-toggle"
  aria-controls="starlight__sidebar"
  aria-label="Hide sidebar"
  title="Hide sidebar"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    width="1em"
    height="1em"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="2" y="2.75" width="12" height="10.5" rx="1.75"></rect>
    <path d="M6 2.75v10.5"></path>
  </svg>
</button>
<a href={siteTitleHref} class="site-title sl-flex">
  <ThemedMark light={faviconPath} dark={faviconDarkPath} />
  <span translate="no">{siteTitle}</span>
</a>
<SiteSwitcher />

<script>
  import { SIDEBAR_SHOWN_EVENT, SIDEBAR_STATE_KEY } from '../lib/sidebar-state';

  const root = document.documentElement;
  const button =
    document.querySelector<HTMLButtonElement>('.kb-sidebar-toggle');

  function show(hidden: boolean): void {
    if (hidden) {
      root.dataset.kbSidebar = 'hidden';
    } else {
      delete root.dataset.kbSidebar;
    }
    if (button) {
      // The label says what a press does; the state is not repeated.
      const label = hidden ? 'Show sidebar' : 'Hide sidebar';
      button.setAttribute('aria-label', label);
      button.title = label;
    }
  }

  show(root.dataset.kbSidebar === 'hidden');
  button?.addEventListener('click', () => {
    const hidden = root.dataset.kbSidebar !== 'hidden';
    show(hidden);
    if (!hidden) {
      document.dispatchEvent(new Event(SIDEBAR_SHOWN_EVENT));
    }
    try {
      if (hidden) {
        localStorage.setItem(SIDEBAR_STATE_KEY, 'hidden');
      } else {
        localStorage.removeItem(SIDEBAR_STATE_KEY);
      }
    } catch {
      // Storage may be unavailable; the choice then lasts for this page.
    }
  });
</script>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      color: var(--kb-text-accent);
      font-size: var(--kb-text-h4);
      font-weight: 600;
      gap: var(--kb-nav-gap);
      min-width: 0;
      text-decoration: none;
      white-space: nowrap;
    }

    .site-title :global(img) {
      height: calc(var(--kb-nav-height) - 2 * var(--kb-nav-pad-y));
      object-fit: contain;
      width: auto;
    }

    .kb-sidebar-toggle {
      display: none;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 2rem;
      height: 2rem;
      margin-inline-end: calc(var(--kb-nav-gap) / 2);
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0.375rem;
      color: var(--kb-gray-3);
      cursor: pointer;
      font-size: 1.25rem;
    }

    .kb-sidebar-toggle:hover,
    .kb-sidebar-toggle:focus-visible {
      background: var(--kb-surface-hover);
      color: var(--kb-text);
    }

    @media (min-width: 50em) {
      :global(:root[data-has-sidebar]) .kb-sidebar-toggle {
        display: inline-flex;
      }
    }

    span {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
