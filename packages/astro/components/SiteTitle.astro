---
/**
 * The mark and the site's name in the header. The mark is the project's own
 * icon, `brand.faviconPath` in its configuration, so one file names the site
 * in the tab and in the header. Where the project also draws it for a dark
 * ground, `brand.faviconDarkPath`, the header shows that one under the dark
 * theme the reader chose on the site, whatever their system's setting. Its
 * shape is the file's own: the stylesheet sets its height and the width
 * follows.
 */
import { siteConfiguration } from '../lib/project';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const { faviconPath, faviconDarkPath } = siteConfiguration.brand;
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    faviconDarkPath ? (
      <>
        <img class="mark-light" src={faviconPath} alt="" />
        <img class="mark-dark" src={faviconDarkPath} alt="" />
      </>
    ) : (
      <img src={faviconPath} alt="" />
    )
  }
  <span translate="no">{siteTitle}</span>
</a>

<style>
  @layer starlight.core {
    .site-title {
      align-items: center;
      color: var(--kb-text-accent);
      font-size: var(--kb-text-h4);
      font-weight: 600;
      gap: var(--kb-nav-gap);
      min-width: 0;
      text-decoration: none;
      white-space: nowrap;
    }

    img {
      height: calc(var(--kb-nav-height) - 2 * var(--kb-nav-pad-y));
      object-fit: contain;
      width: auto;
    }

    span {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Starlight sets the theme on the root before the page paints. */
    :global(:root[data-theme='dark']) .mark-light,
    :global(:root:not([data-theme='dark'])) .mark-dark {
      display: none;
    }
  }
</style>
