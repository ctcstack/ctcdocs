---
/**
 * The file a PDF's page publishes (ADR-027).
 *
 * The browser shows the PDF in its own viewer, which runs apart from the page,
 * with links to open it on its own or download it. A browser without a viewer
 * on the page, as on most phones, shows the links alone. A PDF too large for
 * the site to serve is linked in Google Drive instead, and the text below is
 * what the page carries.
 */
interface Props {
  googleFileId: string;
  title: string;
  file?: string;
  bytes: number;
  pages: number | null;
  sourceUrl?: string;
}

const { googleFileId, title, file, bytes, pages, sourceUrl } = Astro.props;
const href = file
  ? `/assets/generated/${encodeURIComponent(googleFileId)}/${encodeURIComponent(file)}`
  : undefined;

function formatBytes(value: number): string {
  if (value < 1024 * 1024) {
    return `${Math.max(1, Math.round(value / 1024))} KB`;
  }
  return `${(value / (1024 * 1024)).toFixed(1)} MB`;
}

const facts = [
  pages === null ? undefined : `${pages} ${pages === 1 ? 'page' : 'pages'}`,
  formatBytes(bytes),
]
  .filter(Boolean)
  .join(' · ');
---

<section class="pdf-file" aria-label="PDF file" data-pagefind-ignore>
  {
    href ? (
      <>
        <object
          class="pdf-viewer"
          data={href}
          type="application/pdf"
          title={title}
          aria-label={title}
        >
          <p class="pdf-notice">
            This browser does not show a PDF inside the page. Open it with the
            link below.
          </p>
        </object>
        <p class="pdf-actions">
          <a href={href} rel="noopener" target="_blank">
            Open the PDF
          </a>
          <a href={href} download={`${title}.pdf`}>
            Download
          </a>
          <span class="pdf-facts">PDF · {facts}</span>
        </p>
      </>
    ) : (
      <p class="pdf-notice">
        This PDF ({facts}) is larger than the site can serve.
        {sourceUrl && (
          <>
            {' '}
            <a href={sourceUrl} rel="noopener noreferrer" target="_blank">
              Open it in Google Drive
            </a>
            .
          </>
        )}
      </p>
    )
  }
</section>

<script>
  /*
   * Where the browser has no viewer to show a PDF inside the page, the frame
   * would only hold its fallback text; the links below say the same.
   */
  if (!navigator.pdfViewerEnabled) {
    for (const viewer of document.querySelectorAll('.pdf-viewer')) {
      viewer.remove();
    }
  }
</script>

<style>
  @layer starlight.components {
    .pdf-file {
      margin-block: 1rem 1.5rem;
    }

    .pdf-viewer {
      aspect-ratio: 1 / 1.3;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      display: block;
      max-height: 85vh;
      width: 100%;
    }

    .pdf-actions {
      align-items: baseline;
      display: flex;
      flex-wrap: wrap;
      font-size: var(--sl-text-sm);
      gap: 0.5rem 1.25rem;
      margin-top: 0.75rem;
    }

    .pdf-facts,
    .pdf-notice {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
    }

    /* The object's fallback: a phone has no viewer to fill the frame. */
    .pdf-viewer .pdf-notice {
      margin: 0;
      padding: 1rem;
    }
  }
</style>
