---
/**
 * The synchronization record, used as the full index.
 *
 * Every row carries the date its source document was last edited, so a reader
 * can judge whether an instruction is still current before opening it. This is
 * the complete corpus, and it is published at its own address; the home page
 * may carry a copy of it or link to it. See
 * docs/ADR/011-documentation-design-language.md for the record it descends
 * from and docs/ADR/017-full-index-page.md for the page it now has.
 *
 * On its own page the title is the page's, so the block drops its heading and
 * names itself instead — the group headings below stay the same either way,
 * which is what keeps `/documents/#<folder>` a stable address for a folder.
 */
import { formatDate, type CorpusGroup } from '../lib/corpus';

type Props = { groups: CorpusGroup[]; heading?: boolean };

const { groups, heading = true } = Astro.props;

const TITLE = 'All documents';

/*
 * A folder heading sits one level under whatever titles the index: the block's
 * own heading on the home page, the page title on its own page. The class
 * carries the appearance, so both levels look identical and only the outline
 * changes — which is the thing a screen reader navigates by.
 */
const GroupHeading = heading ? 'h3' : 'h2';
---

{
  /*
  Excluded from the search index: this section lists every document title, so
  indexing it would return the page it sits on alongside every real result.
*/
}
<section
  class="corpus"
  data-pagefind-ignore
  {...heading ? { 'aria-labelledby': 'home-index' } : { 'aria-label': TITLE }}
>
  {
    heading && (
      <h2 class="section-title" id="home-index">
        {TITLE}
      </h2>
    )
  }

  {
    groups.length === 0 ? (
      <p class="corpus-empty">
        No documents have been synchronized yet. Once the pipeline publishes its
        first document from the Shared Drive, it appears here.
      </p>
    ) : (
      groups.map((group) => (
        <section aria-labelledby={group.id} class="corpus-group">
          <GroupHeading class="corpus-group-title" id={group.id}>
            {group.label}
          </GroupHeading>
          <ul class="corpus-list">
            {group.documents.map((entry) => (
              <li>
                <a href={entry.href}>
                  <span class="corpus-entry-title">
                    <svg
                      aria-hidden="true"
                      class="corpus-entry-icon"
                      fill="none"
                      stroke="currentColor"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.5"
                      viewBox="0 0 16 16"
                    >
                      <path d="M9 2H4.5A1.5 1.5 0 0 0 3 3.5v9A1.5 1.5 0 0 0 4.5 14h7a1.5 1.5 0 0 0 1.5-1.5V6z" />
                      <path d="M9 2v4h4" />
                    </svg>
                    {entry.title}
                  </span>
                  {entry.qualifier && (
                    <span class="corpus-entry-qualifier">
                      {entry.qualifier}
                    </span>
                  )}
                  {entry.modified ? (
                    <relative-date class="corpus-entry-date">
                      <time datetime={entry.modified.toISOString()}>
                        {formatDate(entry.modified)}
                      </time>
                    </relative-date>
                  ) : (
                    <span
                      class="corpus-entry-date corpus-entry-date-unknown"
                      title="This document has no recorded source modification time."
                    >
                      Unknown
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</section>

<script>
  import '../scripts/relative-date';
</script>

<style>
  /*
   * Unlayered on purpose, and for the reason the folder cards carry the same
   * reset: this block renders inside Starlight's markdown container, whose
   * `li + li` rule adds a top margin to every item after the first. On a ruled
   * list that margin falls above the row's own border — between a row's text
   * and the line under it — so every row read as bottom-heavy by exactly that
   * margin. Outranking a layered stylesheet takes an unlayered rule.
   */
  .corpus-list > li {
    margin: 0;
  }

  @layer starlight.components {
    .corpus {
      margin-top: 3rem;
    }

    /*
     * The space above belongs between this block and the one before it. On its
     * own page there is no block before it, and the page title already sets
     * the distance.
     */
    .corpus:first-child {
      margin-top: 0;
    }

    .corpus:first-child .corpus-group:first-of-type {
      margin-top: 0;
    }

    .corpus-group {
      margin-top: 2rem;
    }

    .corpus-group-title {
      border-bottom: 1px solid var(--sl-color-hairline);
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-sm);
      font-weight: 600;
      letter-spacing: 0.06em;
      margin: 0;
      padding-bottom: 0.5rem;
      text-transform: uppercase;
    }

    .corpus-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .corpus-list li + li {
      border-top: 1px solid var(--sl-color-hairline);
    }

    /*
     * The whole row is one size, so scale and leading are declared once here
     * rather than on each part. Both are set rather than inherited: the prose
     * values are meant for paragraphs and left a row standing 47px tall for
     * 14px of text. A row is one line of a record, so it takes the table's
     * leading and the padding closes to match.
     */
    .corpus-list a {
      align-items: baseline;
      column-gap: 1rem;
      display: flex;
      flex-wrap: wrap;
      font-size: var(--sl-text-sm);
      line-height: var(--sl-line-height-table);
      padding: 0.5rem 0;
      text-decoration: none;
    }

    /*
     * Set as a record, matching the recency band above and the folder cards:
     * one step below reading size, carrying the same document glyph. Rank
     * inside the row comes from tone, so the name still leads the folder and
     * the date it shares the line with.
     *
     * The negative indent with matching padding hangs a wrapped title under
     * its own first character instead of under the glyph.
     */
    .corpus-entry-title {
      color: var(--sl-color-white);
      flex: 1 1 18ch;
      padding-inline-start: 1.375rem;
      text-indent: -1.375rem;
      text-wrap: pretty;
    }

    /* The theme sets `svg { display: block }`, which would break the line. */
    .corpus-entry-icon {
      color: var(--sl-color-gray-3);
      display: inline-block;
      height: 0.875rem;
      margin-inline-end: 0.5rem;
      vertical-align: -0.0625em;
      width: 0.875rem;
    }

    .corpus-list a:hover :is(.corpus-entry-title, .corpus-entry-icon) {
      color: var(--sl-color-text-accent);
    }

    .corpus-list a:focus-visible {
      border-radius: 0.25rem;
      outline: 2px solid var(--sl-color-text-accent);
      outline-offset: 2px;
    }

    .corpus-entry-qualifier {
      color: var(--sl-color-gray-3);
    }

    /*
     * Dates align into a column the eye can scan down. Freshness is the point
     * of this page, so age carries rank: recently edited documents sit at ink
     * weight, settled ones recede. The step is tonal, not chromatic — the
     * accent stays reserved.
     */
    .corpus-entry-date {
      color: var(--sl-color-gray-3);
      display: block;
      font-variant-numeric: tabular-nums;
      text-align: end;
      white-space: nowrap;
    }

    @media (min-width: 30rem) {
      .corpus-entry-date {
        flex: 0 0 8.5rem;
      }
    }

    .corpus-entry-date[data-age='fresh'] {
      color: var(--sl-color-white);
      font-weight: 500;
    }

    .corpus-entry-date[data-age='recent'] {
      color: var(--sl-color-gray-2);
    }

    /*
     * Kept at the same tone as a real date: a lighter gray fell below the
     * contrast floor in the light theme, and this is text a reader must read.
     */
    .corpus-entry-date-unknown {
      font-style: italic;
    }

    .corpus-empty {
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      color: var(--sl-color-gray-3);
      margin-top: 1.25rem;
      padding: 1rem;
    }
  }
</style>
