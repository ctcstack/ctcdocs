---
/**
 * Who may read each folder, for admins (ADR-045).
 *
 * The page answers three questions. Who may read this folder or this
 * document: the folders as rows, each with its readers in words, the groups
 * the rules name as columns, and how each group comes to read it or why it
 * does not. What a reader in some groups may read: "Read as" dims, or hides,
 * the rest, and counts what is left. Where access is not what the rules say:
 * folders without a rule, documents that read narrower than their folder,
 * groups a rule names that a rule above does not, and rules that drifted,
 * first and in words; the content health page keeps them as tasks.
 *
 * It is built from the model the access map is computed from, so it says what
 * the Worker of the same build enforces. It names groups, never people: who is
 * in a group is Google Admin's to say (ADR-040). The address keeps a view in
 * its fragment, which never reaches the server. Without script every folder
 * is listed, unfolded.
 *
 * It is built only when the project has access rules, read by admins only,
 * and kept out of the sidebar and search.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import { PLATFORM_ROUTE_HREFS } from '@ctcstack/ctcdocs-core';

import { loadAccessReview } from '../lib/access-review-source';
import type {
  Attention,
  Mark,
  Reach,
  ReviewDocument,
  ReviewFolder,
} from '../lib/access-review-view';
import { siteConfiguration } from '../lib/project';

const review = await loadAccessReview();
const mcp = siteConfiguration.mcp?.enabled === true;

/** Above this many folders, the tree opens on its top level. */
const UNFOLDED_UP_TO = 25;
const ROOT_NAME = 'Top of the Drive';

const plural = (count: number, one: string, many = `${one}s`) =>
  `${count} ${count === 1 ? one : many}`;
const list = (items: readonly string[]) =>
  items.length <= 2
    ? items.join(' and ')
    : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`;

const REACHES: readonly { id: Reach; label: string }[] = [
  { id: 'members', label: 'Every member' },
  { id: 'groups', label: 'Some groups' },
  { id: 'admins', label: 'Admins only' },
];

const rows = review?.folders ?? [];
const byId = new Map(rows.map((row) => [row.id, row]));
const nameOf = (row: ReviewFolder | undefined) =>
  row ? (row.root ? ROOT_NAME : row.name) : '';
const anchorOf = (id: string) => `folder-${id}`;
/** Each row's folders above it, by anchor, for folding and finding. */
const ancestors = new Map<string, string[]>();
for (const row of rows) {
  ancestors.set(
    row.id,
    row.parent === null
      ? []
      : [...(ancestors.get(row.parent) ?? []), anchorOf(row.parent)],
  );
}
/** Rows a reader is sent to from "Needs attention" stay unfolded. */
const unfold = new Set(
  (review?.attention ?? []).flatMap((item) =>
    item.kind === 'narrower'
      ? (ancestors.get(item.folder.id) ?? [])
      : 'trail' in item.finding
        ? (ancestors.get(item.finding.folder) ?? [])
        : [],
  ),
);
const foldDeep = rows.length > UNFOLDED_UP_TO;

/** A group address set as its name, then its domain, to wrap between. */
const parts = (address: string) => {
  const at = address.indexOf('@');
  return at < 0
    ? { name: address, domain: '' }
    : { name: address.slice(0, at), domain: address.slice(at) };
};
const readersText = (readers: ReviewFolder['readers']) =>
  readers === '*'
    ? 'Every member'
    : readers.length === 0
      ? 'Admins only'
      : list(readers);
const readersData = (readers: ReviewFolder['readers']) =>
  readers === '*' ? '*' : readers.join(' ');

const MARKS: Record<Exclude<Mark, 'none'>, string> = {
  here: 'Reads: the rule on this folder names it',
  above: 'Reads: a rule above names it',
  blocked: 'Named here but not by a rule above, so it admits no one here',
};
const EVERY_MEMBER_MARKS: Record<Exclude<Mark, 'none' | 'blocked'>, string> = {
  here: 'Every member reads it: the rule on this folder says so',
  above: 'Every member reads it: a rule above says so',
};

/** Where a folder's readers come from, in words. */
function origin(row: ReviewFolder): string {
  if (row.closed === 'no-rule') {
    return 'No rule on it or above';
  }
  const names = row.ruledBy.map((id) =>
    id === row.id ? 'this folder' : nameOf(byId.get(id)),
  );
  const from = `${row.ruledBy.length === 1 ? 'Rule' : 'Rules'} on ${list(names)}`;
  return row.closed === 'no-reader' ? `${from} name no group in common` : from;
}

function narrowerText(document: ReviewDocument): string {
  return document.narrower === 'move'
    ? `It moved here and keeps the readers it had, ${readersText(document.readers)}, until a rule on this folder or above is added or changed.`
    : `It keeps the readers it was published with, ${readersText(document.readers)}, until the next sync.`;
}

/** What an item of "Needs attention" says, after the folder it names. */
function attentionText(item: Attention): string {
  if (item.kind === 'narrower') {
    return item.document.narrower === 'move'
      ? `${item.document.title} moved here and keeps fewer readers than its folder until a rule on its new place is added or changed`
      : `${item.document.title} has fewer readers than its folder until the next sync`;
  }
  const { finding } = item;
  switch (finding.code) {
    case 'folder-without-rule':
      return `No rule: ${plural(finding.documents, 'document')} open to admins only until a rule names this folder or one above`;
    case 'rule-group-not-admitted-above':
      return `${list(finding.groups)} ${finding.groups.length === 1 ? 'is' : 'are'} named here but not by a rule above, so ${finding.groups.length === 1 ? 'it admits' : 'they admit'} no one here`;
    case 'rule-folder-missing':
      return `A rule names a folder the site does not have: update or remove it`;
    case 'rule-label-outdated':
      return `The rule still calls it “${finding.label}”`;
  }
}

function attentionPlace(item: Attention): {
  name: string;
  href: string | undefined;
} {
  if (item.kind === 'narrower') {
    return { name: nameOf(item.folder), href: `#${anchorOf(item.folder.id)}` };
  }
  const { finding } = item;
  if (finding.code === 'rule-folder-missing') {
    return { name: finding.label, href: undefined };
  }
  const row = byId.get(finding.folder);
  return {
    name: row ? nameOf(row) : finding.name,
    href: row ? `#${anchorOf(row.id)}` : undefined,
  };
}

const ruleSnippet = (row: ReviewFolder) =>
  row.ruleToAdd
    ? `{ "folder": ${JSON.stringify(row.ruleToAdd.folder)}, "label": ${JSON.stringify(row.ruleToAdd.label)}, "readers": [] }`
    : '';

const total = review?.documents.total ?? 0;
const warnings = (review?.attention ?? []).filter(
  (item) => item.tone === 'warning',
).length;
---

<StarlightPage
  frontmatter={{
    title: 'Access review',
    description:
      'Who may read each folder on this site, by Google group, and where access is not what the rules say.',
    tableOfContents: false,
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <access-review
    class="not-content"
    data-pagefind-ignore
    data-admins={review?.admins.join(' ')}
  >
    {
      !review ? (
        <p class="review-intro">
          This site has no access rules: every signed-in member reads every
          document.
        </p>
      ) : (
        <>
          <p class="review-intro">
            Who may read each folder on this site
            {mcp && ', and through its MCP server'}, by Google group. Drive's
            own sharing and the project repository are not covered; see{' '}
            <a href="#how-access-works">how access works</a>.
          </p>

          <section
            class="review-overview"
            aria-labelledby="review-overview-title"
          >
            <p class="review-eyebrow">Whole knowledge base</p>
            <p class="review-hero-title" id="review-overview-title">
              <span class="review-hero-figure">{total}</span>{' '}
              {total === 1 ? 'document' : 'documents'}, by who may read them
            </p>
            {total > 0 && (
              <div
                class="review-stack"
                role="img"
                aria-label={REACHES.filter(
                  (reach) => review.documents[reach.id] > 0,
                )
                  .map(
                    (reach) => `${reach.label}: ${review.documents[reach.id]}`,
                  )
                  .join(', ')}
              >
                {REACHES.filter((reach) => review.documents[reach.id] > 0).map(
                  (reach) => (
                    <span
                      data-reach={reach.id}
                      style={`--share: ${(review.documents[reach.id] / total) * 100}%`}
                      title={`${reach.label}: ${review.documents[reach.id]}`}
                    />
                  ),
                )}
              </div>
            )}
            <ul
              class="review-legend"
              aria-label="Documents by who may read them"
            >
              {REACHES.map((reach) => (
                <li data-reach={reach.id}>
                  <span class="review-dot" />
                  <span>{reach.label}</span>
                  <strong>{review.documents[reach.id]}</strong>
                </li>
              ))}
            </ul>
            <p class="review-context">
              {review.admins.length === 1
                ? `The admin group, ${review.admins[0]}, reads`
                : `The admin groups, ${list(review.admins)}, read`}{' '}
              everything, whatever the rules say.{' '}
              <span data-live>
                This page shows the rules this build was made with; who is in
                each group could not be read here. It is managed in Google
                Admin.
              </span>
            </p>
          </section>

          <section
            class="review-attention"
            aria-labelledby="review-now-title"
            data-tone="danger"
            data-now
            hidden
          >
            <h2 id="review-now-title">
              <Icon name="error" size="1.25rem" />
              <span>Right now</span>
              <span class="review-count" data-now-count />
            </h2>
            <ul class="review-attention-list" data-now-list />
          </section>

          <section
            class="review-attention"
            aria-labelledby="review-attention-title"
            data-tone={warnings > 0 ? 'warning' : 'note'}
          >
            {review.attention.length === 0 ? (
              <p class="review-all-clear" data-tone="good">
                <Icon name="approve-check-circle" size="1.25rem" />
                <span id="review-attention-title">
                  Nothing needs attention: every folder has a rule, and every
                  document reads as its folder.
                </span>
              </p>
            ) : (
              <>
                <h2 id="review-attention-title">
                  <Icon
                    name={warnings > 0 ? 'warning' : 'information'}
                    size="1.25rem"
                  />
                  <span>Needs attention</span>
                  <span class="review-count">{review.attention.length}</span>
                </h2>
                <ul class="review-attention-list">
                  {review.attention.map((item) => {
                    const place = attentionPlace(item);
                    return (
                      <li data-tone={item.tone}>
                        <Icon
                          name={item.tone === 'warning' ? 'warning' : 'pencil'}
                          size="1rem"
                        />
                        <span>
                          {place.href ? (
                            <a href={place.href} data-goto>
                              {place.name}
                            </a>
                          ) : (
                            <strong>{place.name}</strong>
                          )}
                          {' — '}
                          {attentionText(item)}
                        </span>
                      </li>
                    );
                  })}
                </ul>
                <p class="review-attention-tasks">
                  The{' '}
                  <a
                    href={`${PLATFORM_ROUTE_HREFS.contentHealth}#folder-access`}
                  >
                    content health page
                  </a>{' '}
                  lists the folders among its tasks. A rule is changed in the
                  site's configuration and takes effect with the next deploy.
                </p>
              </>
            )}
          </section>

          <form
            class="review-toolbar"
            aria-label="Read the folders as a reader would"
            hidden
            data-toolbar
          >
            {review.groups.length > 0 && (
              <fieldset class="review-as">
                <legend>Read as</legend>
                <div class="review-chips">
                  {review.groups.map((group) => (
                    <button
                      type="button"
                      class="review-chip"
                      aria-pressed="false"
                      data-as={group}
                    >
                      {group}
                    </button>
                  ))}
                </div>
              </fieldset>
            )}
            <fieldset class="review-as" data-key-chips hidden>
              <legend>Or as a machine key</legend>
              <div class="review-chips" />
            </fieldset>
            <div class="review-tools">
              <div class="review-find">
                <label for="review-find">Find a document or folder</label>
                <input
                  id="review-find"
                  type="search"
                  name="q"
                  autocomplete="off"
                  spellcheck="false"
                />
              </div>
              <label class="review-hide" hidden data-hide-label>
                <input type="checkbox" name="hide" />
                Hide what they cannot read
              </label>
              <div class="review-actions">
                <button type="button" data-clear hidden>
                  Clear
                </button>
                <button type="button" data-copy hidden>
                  Copy link
                </button>
                <button type="button" data-expand>
                  Expand all
                </button>
              </div>
            </div>
            <p class="review-status" role="status" data-status />
          </form>

          <div
            class="review-table-wrap"
            role="region"
            aria-labelledby="review-table-title"
            tabindex="0"
          >
            <table class="review-table">
              <caption id="review-table-title">
                Who may read each folder
              </caption>
              <thead>
                <tr>
                  <th scope="col">Folder</th>
                  <th scope="col">Readers</th>
                  <th scope="col" class="review-col">
                    Every member
                  </th>
                  {review.groups.map((group) => (
                    <th scope="col" class="review-col" data-col={group}>
                      <span class="review-col-name">{parts(group).name}</span>
                      <span class="review-col-domain">
                        {parts(group).domain}
                      </span>
                      <span class="review-col-count" data-group-count hidden />
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => {
                  const narrower = row.direct.filter(
                    (document) => document.narrower,
                  );
                  const above = ancestors.get(row.id) ?? [];
                  return (
                    <tr
                      id={anchorOf(row.id)}
                      data-row
                      data-depth={row.depth}
                      data-ancestors={above.join(' ')}
                      data-readers={readersData(row.readers)}
                      data-reach={row.reach}
                      data-class={row.classId}
                      data-name={nameOf(row)}
                      style={`--depth: ${row.depth}`}
                      data-default-folded={
                        foldDeep &&
                        above.some((anchor) => !unfold.has(anchor)) &&
                        row.depth > 0
                          ? ''
                          : undefined
                      }
                    >
                      <th scope="row">
                        <span class="review-folder">
                          {row.hasChildren ? (
                            <button
                              type="button"
                              class="review-twisty"
                              aria-expanded="true"
                              aria-label={`Subfolders of ${nameOf(row)}`}
                              data-toggle
                            />
                          ) : (
                            <span class="review-twisty-space" />
                          )}
                          {row.href ? (
                            <a href={row.href}>{nameOf(row)}</a>
                          ) : (
                            <span>{nameOf(row)}</span>
                          )}
                        </span>
                        <span class="review-folder-count">
                          {plural(row.documents, 'document')}
                          {row.root && ' in all'}
                        </span>
                        <span class="review-cannot" data-cannot hidden>
                          Cannot open
                        </span>
                      </th>
                      <td class="review-readers">
                        <p class="review-readers-line" data-reach={row.reach}>
                          <span class="review-dot" />
                          <strong>{readersText(row.readers)}</strong>{' '}
                          <span class="review-people" data-people hidden />
                        </p>
                        <p
                          class="review-narrower"
                          data-tone="danger"
                          data-live-note
                          hidden
                        />
                        <p class="review-origin">
                          {origin(row)}
                          {row.drive && (
                            <>
                              {' · '}
                              <a
                                href={row.drive}
                                rel="noopener noreferrer"
                                target="_blank"
                              >
                                Open in Drive
                                <Icon name="external" size="0.75rem" />
                              </a>
                            </>
                          )}
                        </p>
                        {narrower.map((document) => (
                          <p class="review-narrower" data-tone="warning">
                            <Icon name="warning" size="1rem" />
                            <span>
                              <a href={document.href}>{document.title}</a> has
                              fewer readers than its folder.{' '}
                              {narrowerText(document)}
                            </span>
                          </p>
                        ))}
                        {row.direct.length > 0 && (
                          <details class="review-documents" data-documents>
                            <summary>
                              {plural(row.direct.length, 'document')} directly
                              in it
                            </summary>
                            <ul>
                              {row.direct.map((document) => (
                                <li
                                  data-title={document.title}
                                  data-readers={readersData(document.readers)}
                                >
                                  <a href={document.href}>{document.title}</a>
                                  {document.narrower && (
                                    <span class="review-badge">
                                      {readersText(document.readers)}
                                    </span>
                                  )}
                                  <span
                                    class="review-cannot"
                                    data-cannot
                                    hidden
                                  >
                                    Cannot open
                                  </span>
                                </li>
                              ))}
                            </ul>
                          </details>
                        )}
                        {row.ruleToAdd && (
                          <details class="review-rule" data-rule>
                            <summary>Rule to add</summary>
                            <pre set:text={ruleSnippet(row)} />
                            <button type="button" data-copy-rule hidden>
                              Copy rule
                            </button>
                            <p>
                              Add it to <code>access.rules</code> with the
                              groups that may read the folder in{' '}
                              <code>readers</code>, or <code>["*"]</code> for
                              every member. The configuration refuses it until
                              they are written.
                            </p>
                          </details>
                        )}
                      </td>
                      <td class="review-cell" data-mark={row.everyMember}>
                        {row.everyMember !== 'none' &&
                          row.everyMember !== 'blocked' && (
                            <span
                              class="review-mark"
                              title={EVERY_MEMBER_MARKS[row.everyMember]}
                            >
                              <span class="sr-only">
                                {EVERY_MEMBER_MARKS[row.everyMember]}
                              </span>
                            </span>
                          )}
                      </td>
                      {review.groups.map((group) => {
                        const mark = row.groups[group] ?? 'none';
                        return (
                          <td
                            class="review-cell"
                            data-mark={mark}
                            data-col={group}
                          >
                            {mark !== 'none' && (
                              <span class="review-mark" title={MARKS[mark]}>
                                <span class="sr-only">{MARKS[mark]}</span>
                              </span>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          <ul class="review-key" aria-label="What the marks mean">
            <li>
              <span class="review-mark" data-mark="here" aria-hidden="true" />
              The rule on this folder names it
            </li>
            <li>
              <span class="review-mark" data-mark="above" aria-hidden="true" />A
              rule above names it
            </li>
            <li>
              <span
                class="review-mark"
                data-mark="blocked"
                aria-hidden="true"
              />
              Named here, not above: admits no one
            </li>
          </ul>

          <section
            class="review-keys"
            aria-labelledby="review-keys-title"
            data-keys
            hidden
          >
            <h2 id="review-keys-title">Machine keys</h2>
            <p class="review-keys-lede">
              A key reads as the groups it was issued, never as an admin, and
              lasts 90 days at most. Choose one under "Read as" to see what it
              opens.
            </p>
            <ul data-key-list />
          </section>

          <section class="review-how" id="how-access-works">
            <h2>How access works</h2>
            <ul>
              <li>
                A folder's readers are the groups every rule on it and above
                names. A rule below can only narrow what a rule above allows;{' '}
                <code>*</code> is every signed-in member.
              </li>
              <li>
                A folder with no rule on it or above is open to admins only,
                until a rule names it.
              </li>
              <li>
                A document reads as its folder. One moved in Drive to a place
                with more readers keeps the readers it had until a rule on its
                new place is added or changed.
              </li>
              <li>
                Every member sees every document's title in navigation and
                indexes; only readers see its text.
              </li>
              <li>
                A rule change takes effect with the deploy that carries it. A
                change of group membership reaches the site within about ten
                minutes.
              </li>
              <li>
                These rules decide what this site
                {mcp && ' and its MCP server'} serve. Drive's own sharing is set
                apart, in Drive, and everyone who can read the project
                repository reads every folder.
              </li>
            </ul>
          </section>
          <p class="review-footer">
            Browse <a href={PLATFORM_ROUTE_HREFS.fullIndex}>all documents</a>,
            or see the{' '}
            <a href={PLATFORM_ROUTE_HREFS.contentHealth}>content health</a>{' '}
            page.
          </p>
        </>
      )
    }
  </access-review>
</StarlightPage>

<script>
  /**
   * Folds the tree, reads it as a set of groups or a machine key, and finds a
   * document, in the browser over the rendered page. The fragment keeps the
   * view, `#as=a@x,b@x&q=text&hide=1` or `#machine=name`, and never reaches the
   * server; a fragment without `=` is a folder's anchor, which unfolds its row.
   *
   * The one request asks the Worker what holds now (ADR-045): when the
   * directory was read, each group's size and whether it admits anyone, how
   * many people may read each class, and the machine keys. It is laid over
   * the rules as built; without an answer the page is the rules alone.
   */
  import {
    readDirectoryStatus,
    type DirectoryStatus,
    type MachineKey,
  } from '../scripts/directory-status';

  const fold = (text: string) => text.normalize('NFKC').toLocaleLowerCase();
  const plural = (count: number, one: string, many = `${one}s`) =>
    `${count} ${count === 1 ? one : many}`;
  const list = (items: readonly string[]) =>
    items.length <= 2
      ? items.join(' and ')
      : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`;
  const people = (count: number) => plural(count, 'person', 'people');

  /** `3 minutes ago`, or nothing for a time in the future or unreadable. */
  function ago(time: string): string {
    const minutes = Math.round((Date.now() - Date.parse(time)) / 60_000);
    if (!(minutes >= 0)) return '';
    const format = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
    if (minutes < 60) return format.format(-minutes, 'minute');
    if (minutes < 48 * 60)
      return format.format(-Math.round(minutes / 60), 'hour');
    return format.format(-Math.round(minutes / 1440), 'day');
  }

  /** An element with text, built without parsing markup. */
  function element(
    tag: string,
    text?: string,
    attributes: Record<string, string> = {},
  ): HTMLElement {
    const node = document.createElement(tag);
    if (text !== undefined) node.textContent = text;
    for (const [name, value] of Object.entries(attributes)) {
      node.setAttribute(name, value);
    }
    return node;
  }

  class AccessReview extends HTMLElement {
    private rows: HTMLTableRowElement[] = [];
    private summary = '';
    /** What the Worker said holds now, once it has answered. */
    private live: DirectoryStatus | undefined;
    /** Named groups that admit no one now, with the reason. */
    private shut = new Map<string, string>();
    /** The machine key the page reads as, if one. */
    private key: MachineKey | undefined;

    connectedCallback() {
      this.rows = [
        ...this.querySelectorAll<HTMLTableRowElement>('tr[data-row]'),
      ];
      const form = this.querySelector<HTMLFormElement>('[data-toolbar]');
      const status = this.querySelector<HTMLElement>('[data-status]');
      if (!form || !status) return;
      form.hidden = false;

      // A long tree opens on its top level and on the rows it points at.
      for (const row of this.rows) {
        if (row.hasAttribute('data-default-folded')) {
          this.setFolded(this.parentOf(row), true);
        }
      }
      for (const toggle of this.querySelectorAll<HTMLButtonElement>(
        '[data-toggle]',
      )) {
        toggle.addEventListener('click', () => {
          const row = toggle.closest<HTMLTableRowElement>('tr');
          if (row) this.setFolded(row, toggle.ariaExpanded === 'true');
          this.labelExpand();
        });
      }

      // A group's column header reads as that group too.
      for (const header of this.querySelectorAll<HTMLElement>('th[data-col]')) {
        const group = header.dataset.col ?? '';
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'review-col-button';
        button.dataset.as = group;
        button.setAttribute('aria-pressed', 'false');
        button.title = `Read as ${group}`;
        button.append(...header.childNodes);
        header.append(button);
      }

      for (const button of this.querySelectorAll<HTMLButtonElement>(
        'button[data-as]',
      )) {
        button.addEventListener('click', () => {
          const chosen = this.key ? [] : this.chosen();
          this.key = undefined;
          const group = button.dataset.as ?? '';
          this.apply(
            form,
            status,
            chosen.includes(group)
              ? chosen.filter((entry) => entry !== group)
              : [...chosen, group],
          );
        });
      }
      form.addEventListener('submit', (event) => event.preventDefault());
      form.addEventListener('input', () =>
        this.apply(form, status, this.chosen()),
      );
      form.querySelector('[data-clear]')?.addEventListener('click', () => {
        form.reset();
        this.key = undefined;
        this.apply(form, status, []);
      });
      const expand = this.querySelector<HTMLButtonElement>('[data-expand]');
      expand?.addEventListener('click', () => {
        const folded = this.anyFolded();
        for (const row of this.rows) {
          if (row.querySelector('[data-toggle]')) this.setFolded(row, !folded);
        }
        this.labelExpand();
      });
      const copy = this.querySelector<HTMLButtonElement>('[data-copy]');
      copy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          copy.textContent = 'Link copied';
        } catch {
          copy.textContent = 'Copy the address bar';
        }
        setTimeout(() => (copy.textContent = 'Copy link'), 2000);
      });

      // A rule to add is copied whole, ready to paste.
      for (const rule of this.querySelectorAll<HTMLElement>('[data-rule]')) {
        const button =
          rule.querySelector<HTMLButtonElement>('[data-copy-rule]');
        if (!button || !navigator.clipboard) continue;
        button.hidden = false;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(
              rule.querySelector('pre')?.textContent ?? '',
            );
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Select it to copy';
          }
          setTimeout(() => (button.textContent = 'Copy rule'), 2000);
        });
      }

      this.summary = status.textContent ?? '';
      const restore = () => {
        const state = this.readFragment();
        const find = form.elements.namedItem('q');
        if (find instanceof HTMLInputElement) find.value = state.q;
        const hide = form.elements.namedItem('hide');
        if (hide instanceof HTMLInputElement) hide.checked = state.hide;
        // A key is known once the Worker has answered.
        this.key = this.live?.machineKeys.find((key) => key.name === state.key);
        this.apply(
          form,
          status,
          this.key ? this.keyGroups(this.key) : state.as,
          false,
        );
      };
      restore();
      this.goTo(location.hash);
      // A link to a view, or to a folder, followed on this page.
      window.addEventListener('hashchange', () => {
        if (location.hash.includes('=')) restore();
        else this.goTo(location.hash);
      });
      this.labelExpand();
      void this.showLive(form, status, restore);
    }

    /** The groups a key reads as that the rules name. */
    keyGroups(key: MachineKey): string[] {
      const named = new Set(this.knownGroups());
      return key.groups.filter((group) => named.has(group));
    }

    knownGroups(): string[] {
      return [...this.querySelectorAll<HTMLElement>('.review-chip')].map(
        (chip) => chip.dataset.as ?? '',
      );
    }

    /** Lays what holds now over the rules, when the Worker answers. */
    async showLive(
      form: HTMLFormElement,
      status: HTMLElement,
      restore: () => void,
    ) {
      const live = await readDirectoryStatus();
      if (!live) return;
      this.live = live;
      const known = new Set(this.knownGroups());
      const admins = (this.dataset.admins ?? '').split(' ').filter(Boolean);
      this.shut = new Map(
        [...known, ...admins].flatMap((group) => {
          const entry = live.groups.get(group);
          const reason = !entry
            ? 'the directory has not read it yet'
            : entry.admitsNoOne;
          return reason ? [[group, reason] as const] : [];
        }),
      );

      const line = this.querySelector<HTMLElement>('[data-live]');
      if (line) {
        line.textContent = live.takenAt
          ? `Group membership was read ${ago(live.takenAt)}: ${plural(live.activeUsers, 'active person', 'active people')}. A folder's count includes the admins. Who is in a group is managed in Google Admin.`
          : 'The directory has not been read yet, so no one is admitted. Who is in a group is managed in Google Admin.';
      }

      // Each group's size, or that it admits no one.
      for (const count of this.querySelectorAll<HTMLElement>(
        '[data-group-count]',
      )) {
        const group =
          count.closest<HTMLElement>('[data-col]')?.dataset.col ?? '';
        const entry = live.groups.get(group);
        count.hidden = false;
        count.textContent = this.shut.has(group)
          ? 'admits no one'
          : people(entry?.members ?? 0);
        count.toggleAttribute('data-shut', this.shut.has(group));
      }
      for (const cell of this.querySelectorAll<HTMLElement>('td[data-col]')) {
        cell.toggleAttribute(
          'data-shut',
          this.shut.has(cell.dataset.col ?? ''),
        );
      }

      // How many may read each folder now, and what a shut group takes away.
      for (const row of this.rows) {
        const count = live.classes.get(row.dataset.class ?? '');
        const span = row.querySelector<HTMLElement>('[data-people]');
        if (span && count !== undefined) {
          span.hidden = false;
          span.textContent = people(count);
        }
        const readers = row.dataset.readers ?? '';
        const groups =
          readers === '*' ? [] : readers.split(' ').filter(Boolean);
        const gone = groups.filter((group) => this.shut.has(group));
        const note = row.querySelector<HTMLElement>('[data-live-note]');
        if (note && gone.length > 0) {
          note.hidden = false;
          note.textContent =
            gone.length === groups.length
              ? `Admins only right now: ${list(gone)} ${gone.length === 1 ? 'admits' : 'admit'} no one.`
              : `Fewer readers right now: ${list(gone)} ${gone.length === 1 ? 'admits' : 'admit'} no one.`;
        }
      }

      this.showNow(live);
      this.showKeys(live, form, status);
      restore();
    }

    /** "Right now": a stale directory, and each group that admits no one. */
    showNow(live: DirectoryStatus) {
      const section = this.querySelector<HTMLElement>('[data-now]');
      const items = this.querySelector<HTMLElement>('[data-now-list]');
      if (!section || !items) return;
      items.replaceChildren();
      if (live.stale) {
        const item = element('li', undefined, { 'data-tone': 'danger' });
        item.append(
          element(
            'span',
            'The directory has not been read for over two hours. Until it is, only what every member reads is served, to everyone, admins included.',
          ),
        );
        items.append(item);
      }
      const admins = new Set(
        (this.dataset.admins ?? '').split(' ').filter(Boolean),
      );
      for (const [group, reason] of this.shut) {
        const item = element('li', undefined, { 'data-tone': 'danger' });
        const text = element('span');
        text.append(element('strong', group), ` admits no one: ${reason}.`);
        if (admins.has(group)) {
          text.append(' Its members are not admins until it is fixed.');
        } else {
          const rows = this.rows.filter((row) =>
            (row.dataset.readers ?? '').split(' ').includes(group),
          );
          const closed = rows.filter((row) =>
            (row.dataset.readers ?? '')
              .split(' ')
              .every((reader) => this.shut.has(reader)),
          );
          if (rows.length > 0) {
            text.append(
              ` Its members do not read ${rows.length === 1 ? 'the folder' : `the ${rows.length} folders`} it is named for: `,
            );
            rows.slice(0, 3).forEach((row, index) => {
              if (index > 0) text.append(', ');
              text.append(
                element('a', row.dataset.name ?? '', { href: `#${row.id}` }),
              );
            });
            text.append(
              rows.length > 3 ? ` and ${rows.length - 3} more.` : '.',
            );
            if (closed.length > 0) {
              text.append(
                ` ${plural(closed.length, 'folder')} ${closed.length === 1 ? 'is' : 'are'} left to admins alone.`,
              );
            }
          }
        }
        item.append(text);
        items.append(item);
      }
      section.hidden = items.childElementCount === 0;
      const count = section.querySelector<HTMLElement>('[data-now-count]');
      if (count) count.textContent = String(items.childElementCount);
    }

    /** The machine keys, and a way to read as each. */
    showKeys(
      live: DirectoryStatus,
      form: HTMLFormElement,
      status: HTMLElement,
    ) {
      const section = this.querySelector<HTMLElement>('[data-keys]');
      const items = this.querySelector<HTMLElement>('[data-key-list]');
      const chips = this.querySelector<HTMLElement>('[data-key-chips]');
      if (!section || !items || !chips) return;
      const holder = chips.querySelector<HTMLElement>('.review-chips');
      items.replaceChildren();
      holder?.replaceChildren();
      const soon = 14 * 24 * 60 * 60 * 1000;
      for (const key of live.machineKeys) {
        const groups = this.keyGroups(key);
        const item = element('li', undefined, {
          'data-tone':
            Date.parse(key.expires) - Date.now() < soon ? 'warning' : 'note',
        });
        item.append(
          element('strong', key.name),
          element(
            'span',
            groups.length > 0
              ? `Reads as ${list(groups)}`
              : 'Reads what every member reads',
          ),
          element('span', `Answered for by ${key.owner}`),
          element(
            'span',
            `Expires on ${key.expires.slice(0, 10)}, in ${plural(Math.max(1, Math.ceil((Date.parse(key.expires) - Date.now()) / 86_400_000)), 'day')}`,
          ),
        );
        items.append(item);

        const chip = element('button', key.name, {
          type: 'button',
          class: 'review-chip',
          'aria-pressed': 'false',
          'data-key': key.name,
        });
        chip.addEventListener('click', () => {
          const same = this.key?.name === key.name;
          this.key = same ? undefined : key;
          this.apply(form, status, same ? [] : groups);
        });
        holder?.append(chip);
      }
      section.hidden = live.machineKeys.length === 0;
      chips.hidden = live.machineKeys.length === 0;
    }

    /** The view the fragment names; an anchor names none. */
    readFragment(): { as: string[]; key: string; q: string; hide: boolean } {
      const hash = location.hash.slice(1);
      if (!hash.includes('=')) return { as: [], key: '', q: '', hide: false };
      const params = new URLSearchParams(hash);
      const known = new Set(
        [...this.querySelectorAll<HTMLElement>('.review-chip')].map(
          (chip) => chip.dataset.as ?? '',
        ),
      );
      return {
        as: (params.get('as') ?? '')
          .split(',')
          .filter((group) => known.has(group)),
        // Not `key`, which reads as a secret to people and scanners alike.
        key: params.get('machine') ?? '',
        q: params.get('q') ?? '',
        hide: params.get('hide') === '1',
      };
    }

    /** Unfolds the way to a folder's row a link points at. */
    goTo(hash: string) {
      const id = decodeURIComponent(hash.slice(1));
      if (!id || id.includes('=')) return;
      const target = document.getElementById(id);
      if (!(target instanceof HTMLTableRowElement)) return;
      const folded = target.hasAttribute('data-folded');
      for (const anchor of (target.dataset.ancestors ?? '').split(' ')) {
        const row = anchor ? document.getElementById(anchor) : null;
        if (row instanceof HTMLTableRowElement) this.setFolded(row, false);
      }
      this.labelExpand();
      /*
       * The browser has already gone to a row it could see. One that was
       * folded is gone to now, down the page only: the table keeps its
       * sideways scroll.
       */
      if (folded) {
        const margin = parseFloat(getComputedStyle(target).scrollMarginTop);
        window.scrollTo({
          top: target.getBoundingClientRect().top + window.scrollY - margin,
        });
      }
    }

    parentOf(row: HTMLTableRowElement): HTMLTableRowElement {
      const anchors = (row.dataset.ancestors ?? '').split(' ');
      const parent = document.getElementById(anchors.at(-1) ?? '');
      return parent instanceof HTMLTableRowElement ? parent : row;
    }

    childrenOf(row: HTMLTableRowElement): HTMLTableRowElement[] {
      return this.rows.filter((candidate) =>
        (candidate.dataset.ancestors ?? '').split(' ').includes(row.id),
      );
    }

    /** Folds or unfolds every row below this one. */
    setFolded(row: HTMLTableRowElement, folded: boolean) {
      const toggle = row.querySelector<HTMLButtonElement>('[data-toggle]');
      if (!toggle) return;
      toggle.setAttribute('aria-expanded', String(!folded));
      for (const child of this.childrenOf(row)) {
        child.toggleAttribute('data-folded', folded);
        // Unfolding a row shows its children as they were left.
        if (!folded) {
          const above = (child.dataset.ancestors ?? '')
            .split(' ')
            .filter(Boolean)
            .map((anchor) => document.getElementById(anchor));
          child.toggleAttribute(
            'data-folded',
            above.some(
              (entry) =>
                entry?.querySelector('[data-toggle]')?.ariaExpanded === 'false',
            ),
          );
        }
      }
    }

    anyFolded(): boolean {
      return this.rows.some((row) => row.hasAttribute('data-folded'));
    }

    labelExpand() {
      const expand = this.querySelector<HTMLButtonElement>('[data-expand]');
      if (!expand) return;
      expand.hidden = !this.querySelector('[data-toggle]');
      expand.textContent = this.anyFolded() ? 'Expand all' : 'Collapse all';
    }

    chosen(): string[] {
      return [
        ...this.querySelectorAll<HTMLButtonElement>(
          '.review-chip[aria-pressed="true"]',
        ),
      ].map((chip) => chip.dataset.as ?? '');
    }

    /** Applies "Read as" and the search, and writes them to the fragment. */
    apply(
      form: HTMLFormElement,
      status: HTMLElement,
      groups: string[],
      write = true,
    ) {
      const chosen = new Set(groups);
      const key = this.key;
      for (const button of this.querySelectorAll<HTMLButtonElement>(
        'button[data-as]',
      )) {
        button.setAttribute(
          'aria-pressed',
          String(!key && chosen.has(button.dataset.as ?? '')),
        );
      }
      for (const button of this.querySelectorAll<HTMLButtonElement>(
        'button[data-key]',
      )) {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.key === key?.name),
        );
      }
      for (const cell of this.querySelectorAll<HTMLElement>('[data-col]')) {
        cell.toggleAttribute('data-chosen', chosen.has(cell.dataset.col ?? ''));
      }
      const data = new FormData(form);
      const query = fold(String(data.get('q') ?? '').trim());
      const reading = chosen.size > 0 || !!key;
      const hide = data.get('hide') === 'on' && reading;
      /*
       * As the gate decides: a person is in no group that admits no one, a
       * key reads as its groups whatever the directory says, and a stale
       * directory serves what every member reads, to anyone.
       */
      const stale = this.live?.stale === true;
      const reads = (readers: string) =>
        readers === '*' ||
        (!stale &&
          readers
            .split(' ')
            .some(
              (group) => chosen.has(group) && (!!key || !this.shut.has(group)),
            ));

      // Which rows the search or "Read as" keeps, and the rows above them.
      const kept = new Set<HTMLTableRowElement>();
      let documents = 0;
      let readable = 0;
      let found = 0;
      let foldersFound = 0;
      for (const row of this.rows) {
        const items = [
          ...row.querySelectorAll<HTMLElement>('[data-documents] li'),
        ];
        let matched = false;
        for (const item of items) {
          documents += 1;
          const open = !reading || reads(item.dataset.readers ?? '');
          if (reading && open) readable += 1;
          const hit = !!query && fold(item.dataset.title ?? '').includes(query);
          item.toggleAttribute('data-hit', hit);
          item.toggleAttribute('data-closed', reading && !open);
          const cannot = item.querySelector<HTMLElement>('[data-cannot]');
          if (cannot) cannot.hidden = !reading || open;
          if (hit && (!hide || open)) {
            matched = true;
            found += 1;
          }
        }
        const named = !!query && fold(row.dataset.name ?? '').includes(query);
        if (named) foldersFound += 1;
        const open = !reading || reads(row.dataset.readers ?? '');
        row.toggleAttribute('data-closed', reading && !open);
        const cannot = row.querySelector<HTMLElement>(
          ':scope > th [data-cannot]',
        );
        if (cannot) cannot.hidden = !reading || open;
        const details =
          row.querySelector<HTMLDetailsElement>('[data-documents]');
        if (details && query) details.open = matched;
        const keep =
          (!query || matched || named) &&
          (!hide ||
            open ||
            items.some((item) => !item.hasAttribute('data-closed')));
        if (keep) {
          kept.add(row);
          for (const anchor of (row.dataset.ancestors ?? '').split(' ')) {
            const above = anchor ? document.getElementById(anchor) : null;
            if (above instanceof HTMLTableRowElement) kept.add(above);
          }
        }
      }
      const narrowed = !!query || hide;
      for (const row of this.rows) {
        row.toggleAttribute('data-filtered', narrowed && !kept.has(row));
        // A search shows what it found, wherever it is folded.
        if (query && kept.has(row)) row.removeAttribute('data-folded');
      }
      if (query) {
        for (const row of this.rows) {
          const toggle = row.querySelector('[data-toggle]');
          if (toggle && kept.has(row))
            toggle.setAttribute('aria-expanded', 'true');
        }
      }

      const parts: string[] = [];
      if (reading) {
        const who = key
          ? `The key ${key.name}`
          : `A reader in ${[...chosen].join(' and ')}`;
        parts.push(
          `${who} may open ${readable} of ${documents} ${documents === 1 ? 'document' : 'documents'}.`,
        );
        const gone = key
          ? []
          : [...chosen].filter((group) => this.shut.has(group));
        if (gone.length > 0) {
          parts.push(
            `${list(gone)} ${gone.length === 1 ? 'admits' : 'admit'} no one right now.`,
          );
        }
        if (stale) {
          parts.push(
            'The directory is stale: only what every member reads is served.',
          );
        }
      }
      if (query) {
        const matches = [
          found > 0 && `${found} ${found === 1 ? 'document' : 'documents'}`,
          foldersFound > 0 &&
            `${foldersFound} ${foldersFound === 1 ? 'folder' : 'folders'}`,
        ].filter(Boolean);
        parts.push(
          matches.length === 0
            ? 'Nothing matches.'
            : `${matches.join(' and ')} ${found + foldersFound === 1 ? 'matches' : 'match'}.`,
        );
      }
      status.textContent = parts.length > 0 ? parts.join(' ') : this.summary;

      const hideLabel = form.querySelector<HTMLElement>('[data-hide-label]');
      if (hideLabel) hideLabel.hidden = !reading;
      for (const [selector, hidden] of [
        ['[data-clear]', !reading && !query],
        ['[data-copy]', (!reading && !query) || !navigator.clipboard],
      ] as const) {
        const button = form.querySelector<HTMLElement>(selector);
        if (button) button.hidden = hidden;
      }
      this.labelExpand();

      if (!write) return;
      const params = new URLSearchParams();
      if (key) params.set('machine', key.name);
      else if (reading) params.set('as', [...chosen].join(','));
      if (query) params.set('q', String(data.get('q') ?? '').trim());
      if (hide) params.set('hide', '1');
      // An address is easier to read, and to send, with its @ and commas.
      const fragment = params
        .toString()
        .replaceAll('%40', '@')
        .replaceAll('%2C', ',');
      const url = new URL(location.href);
      url.hash = fragment;
      if (url.href !== location.href) {
        history.replaceState(
          history.state,
          '',
          fragment ? url : url.pathname + url.search,
        );
      }
    }
  }

  customElements.define('access-review', AccessReview);
</script>

<style is:global>
  @layer starlight.components {
    access-review {
      display: block;
      font-size: var(--kb-text-body);

      /*
       * The status hues of the content health page (ADR-037, ADR-045): a hue
       * marks a dot, a bar, an icon or a rule, never text, and always comes
       * with words. Who may read takes hues that read as neither good nor bad.
       */
      --review-members: var(--kb-gray-4);
      --review-groups: color-mix(
        in oklab,
        var(--kb-blue) 70%,
        var(--kb-gray-4)
      );
      --review-admins: var(--kb-purple);
      --review-warning: color-mix(
        in oklab,
        var(--kb-orange) 70%,
        var(--kb-gray-4)
      );
      --review-note: var(--kb-gray-4);
      --review-good: color-mix(in oklab, var(--kb-green) 50%, var(--kb-gray-4));
      --review-mark: var(--kb-ink);
    }

    :root[data-theme='light'] access-review {
      --review-warning: color-mix(
        in oklab,
        var(--kb-orange) 70%,
        var(--kb-gray-1)
      );
      --review-members: color-mix(
        in oklab,
        var(--kb-gray-3) 60%,
        var(--kb-gray-4)
      );
      --review-good: color-mix(in oklab, var(--kb-green) 70%, var(--kb-gray-1));
    }

    access-review [data-reach='members'] {
      --tone: var(--review-members);
    }

    access-review [data-reach='groups'] {
      --tone: var(--review-groups);
    }

    access-review [data-reach='admins'] {
      --tone: var(--review-admins);
    }

    access-review [data-tone='warning'] {
      --tone: var(--review-warning);
      --tone-low: var(--kb-orange-low);
    }

    access-review [data-tone='note'] {
      --tone: var(--review-note);
      --tone-low: var(--kb-gray-6);
    }

    access-review [data-tone='danger'] {
      --tone: var(--kb-red);
      --tone-low: var(--kb-red-low);
    }

    access-review [data-tone='good'] {
      --tone: var(--review-good);
      --tone-low: var(--kb-green-low);
    }

    access-review [hidden] {
      display: none !important;
    }

    access-review p,
    access-review ul {
      margin: 0;
    }

    access-review a {
      color: var(--kb-text-accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }

    access-review code {
      font-size: 0.875em;
    }

    access-review .review-intro {
      color: var(--kb-gray-3);
    }

    /* ---------------------------------------------------------- overview */

    access-review .review-overview,
    access-review .review-attention {
      border: 1px solid var(--kb-hairline);
      border-radius: 0.75rem;
      margin-top: 1.5rem;
      padding: 1rem 1.5rem 1.25rem;
    }

    access-review .review-eyebrow {
      color: var(--kb-gray-3);
      font-size: var(--kb-text-xs);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    access-review .review-hero-title {
      color: var(--kb-ink);
