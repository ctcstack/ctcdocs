---
/**
 * What editors have to fix, grouped by the action that fixes it (ADR-024),
 * and what in the published folders is not on the site, with why (ADR-025).
 *
 * Every item links to the document in Google Drive or Docs, at the paragraph
 * concerned when the check is about one, and to its page on this site when it
 * has one. Filters narrow the list to one section of the corpus or to whoever
 * last edited a file, which is how the work is shared out. The page is rebuilt
 * on every sync, so a fixed item disappears after the next one.
 *
 * It is not in the sidebar and not in search: it is an address people are
 * sent to, not part of the documentation.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { PLATFORM_ROUTE_HREFS } from '@ctcstack/ctcdocs-core';

import HealthSummaryTable from '../components/HealthSummaryTable.astro';
import {
  googleDocsUrl,
  loadHealthReport,
  loadSyncState,
  sectionOf,
  whereOf,
  type HealthSeverity,
  type UnpublishedItem,
} from '../lib/content-health';

const report = loadHealthReport();
const state = loadSyncState();

const SEVERITIES: Array<{
  severity: HealthSeverity;
  heading: string;
  lede: string;
  open: boolean;
}> = [
  {
    severity: 'fix',
    heading: 'Fix',
    lede: 'Mistakes a reader can run into. Each takes a minute.',
    open: true,
  },
  {
    severity: 'convention',
    heading: 'Proposed convention: one Title line',
    lede: "Every document opens with its name as one line in the Title style, and uses Heading 1 to 3 for its sections. The site will take a document's title from that line once the convention is agreed.",
    open: true,
  },
  {
    severity: 'note',
    heading: 'Worth a look',
    lede: 'Tidiness in Drive names. The site shows these names today.',
    open: false,
  },
];

/** A group this long starts folded; its row in the table says what it holds. */
const OPEN_UP_TO = 20;

const byName = (left: string, right: string) => left.localeCompare(right, 'en');
const documents = report?.documents ?? [];
const unpublished = state?.unpublished ?? [];
const ignoredFolders = state?.ignoredFolders ?? [];
const notes = state?.notes ?? [];
const sections = [
  ...new Set([
    ...documents.map(sectionOf),
    ...unpublished.map(sectionOf),
    ...ignoredFolders.map(sectionOf),
    ...notes.map(sectionOf),
  ]),
].sort(byName);
const editors = [
  ...new Set(
    [...documents, ...unpublished, ...notes].flatMap((item) =>
      item.lastEditedBy ? [item.lastEditedBy] : [],
    ),
  ),
].sort(byName);

const groups = (report?.checks ?? []).map((check) => ({
  check,
  documents: documents
    .map((document) => ({
      document,
      issues: document.issues.filter((issue) => issue.check === check.code),
    }))
    .filter((entry) => entry.issues.length > 0),
}));
const unpublishedGroups = (state?.reasons ?? [])
  .map((reason) => ({
    reason,
    items: unpublished.filter((item) => item.reason === reason.code),
  }))
  .filter((group) => group.items.length > 0);
const noteGroups = (state?.noteKinds ?? [])
  .map((kind) => ({
    kind,
    items: notes.filter((note) => note.note === kind.code),
  }))
  .filter((group) => group.items.length > 0);

const published = state
  ? state.summary.published.googleDocs + state.summary.published.pdfs
  : undefined;
const plural = (count: number, one: string, many = `${one}s`) =>
  `${count} ${count === 1 ? one : many}`;
const trail = (item: { folderPath: readonly string[] }) =>
  item.folderPath.length > 0 ? item.folderPath.join(' › ') : 'General';
const isFileNameCheck = (code: string) => code.startsWith('file-name-');
const status = (item: UnpublishedItem) =>
  item.status === 'incomplete'
    ? 'On the site, incomplete.'
    : item.status === 'out-of-date' && item.publishedVersion
      ? `The site shows the version edited on ${item.publishedVersion.slice(0, 10)}.`
      : 'Not on the site.';
---

<StarlightPage
  frontmatter={{
    title: 'Content health',
    description:
      'What is on the site and what is not, and what to fix in Google Docs and Drive.',
    tableOfContents: false,
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <content-health data-pagefind-ignore>
    {
      !report && !state ? (
        <p>
          The next sync writes the report this page is built from. Check back
          after it has run.
        </p>
      ) : (
        <>
          <p>
            What is on the site and what is not, and what to fix in Google Docs
            and Drive, grouped by what fixes it. Each item links to its file in
            Drive, and to its page when it has one. The page is rebuilt on every
            sync, so a fixed item disappears after the next one.
          </p>

          <dl class="health-stats">
            {state && published !== undefined && (
              <>
                <div>
                  <dt>On the site</dt>
                  <dd>
                    {published}
                    <span class="health-stat-detail">
                      {`${plural(state.summary.published.googleDocs, 'Google Doc')}, ${plural(state.summary.published.pdfs, 'PDF')}`}
                    </span>
                  </dd>
                </div>
                <div>
                  <dt>
                    <a href="#not-on-the-site">Not on the site</a>
                  </dt>
                  <dd>{unpublished.length}</dd>
                </div>
                <div>
                  <dt>
                    <a href="#notes">Notes</a>
                  </dt>
                  <dd>{notes.length}</dd>
                </div>
              </>
            )}
            {report && (
              <>
                <div>
                  <dt>
                    <a href="#fix">Documents to fix</a>
                  </dt>
                  <dd>{report.summary.severity.fix}</dd>
                </div>
                <div>
                  <dt>Following the proposed convention</dt>
                  <dd>
                    {report.summary.conforming}
                    <span> of {report.summary.inspected}</span>
                  </dd>
                </div>
              </>
            )}
          </dl>

          {state && (
            <p class="health-notice">
              The site last changed on{' '}
              <time datetime={state.generatedAt}>
                {state.generatedAt.slice(0, 16).replace('T', ' ')} UTC
              </time>
              .
            </p>
          )}
          {report && report.summary.inspected < report.summary.documents && (
            <p class="health-notice">
              {report.summary.documents - report.summary.inspected} documents
              have not been inspected yet. A full sync inspects every document.
            </p>
          )}

          <form class="health-filters" aria-label="Filter the list">
            <label>
              Section
              <select name="section">
                <option value="">All sections</option>
                {sections.map((section) => (
                  <option value={section}>{section}</option>
                ))}
              </select>
            </label>
            {editors.length > 0 && (
              <label>
                Last edited by
                <select name="editor">
                  <option value="">Anyone</option>
                  {editors.map((editor) => (
                    <option value={editor}>{editor}</option>
                  ))}
                </select>
              </label>
            )}
            <p class="health-filter-status" role="status" data-status />
          </form>

          {state && (
            <section class="health-severity" data-severity-section>
              <h2 id="not-on-the-site">Not on the site</h2>
              <p class="health-lede">
                Files in the published folders that the site does not show,
                shows in an earlier version, or shows only in part, grouped by
                what to do about them.
              </p>
              {unpublishedGroups.length === 0 && ignoredFolders.length === 0 ? (
                <p class="health-empty">
                  Every file in the published folders is on the site.
                </p>
              ) : (
                <p class="health-empty" data-filter-empty hidden>
                  Nothing here for this filter.
                </p>
              )}
              {unpublishedGroups.length > 0 && (
                <HealthSummaryTable
                  label="Files not on the site, by what to do"
                  unit="Files"
                  rows={unpublishedGroups.map(({ reason, items }) => ({
                    id: `not-on-the-site-${reason.code}`,
                    title: reason.title,
                    count: items.length,
                    where: whereOf(items),
                    action: reason.action,
                  }))}
                />
              )}
              {unpublishedGroups.map(({ reason, items }) => (
                <details
                  class="health-check"
                  id={`not-on-the-site-${reason.code}`}
                  open={items.length <= OPEN_UP_TO}
                  data-check
                >
                  <summary>
                    <span class="health-check-title">{reason.title}</span>
                    <span class="health-count" data-count>
                      {items.length}
                    </span>
                  </summary>
                  <p class="health-instruction">{reason.instruction}</p>
                  <ul>
                    {items.map((item) => (
                      <li
                        data-section={sectionOf(item)}
                        data-editor={item.lastEditedBy ?? ''}
                      >
                        <div class="health-item-head">
                          {item.slug ? (
                            <a href={`/${item.slug}/`}>{item.name}</a>
                          ) : (
                            <span class="health-item-name">{item.name}</span>
                          )}
                          <a
                            class="health-source"
                            href={item.sourceUrl}
                            rel="noopener noreferrer"
                            target="_blank"
                          >
                            Open in Google Drive
                          </a>
                        </div>
                        <p class="health-meta">
                          {trail(item)} · {item.type}
                          {item.lastEditedBy &&
                            ` · last edited by ${item.lastEditedBy}`}
                        </p>
                        <p class="health-detail">
                          {status(item)}
                          {item.detail && ` ${item.detail}`}
                        </p>
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
              {ignoredFolders.length > 0 && (
                <details class="health-check" data-check>
                  <summary>
                    <span class="health-check-title">
                      Folders the site is configured to leave out
                    </span>
                    <span class="health-count" data-count>
                      {ignoredFolders.length}
                    </span>
                  </summary>
                  <p class="health-instruction">
                    Nothing in these folders is published, on purpose. Ask
                    whoever maintains the site if one of them should be.
                  </p>
                  <ul>
                    {ignoredFolders.map((folder) => (
                      <li data-section={sectionOf(folder)} data-editor="">
                        <div class="health-item-head">
                          <span class="health-item-name">{folder.name}</span>
                        </div>
                        <p class="health-meta">
                          {trail(folder)} · {folder.items}{' '}
                          {folder.items === 1 ? 'item' : 'items'}
                        </p>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          )}

          {state && (
            <section class="health-severity" data-severity-section>
              <h2 id="notes">Notes</h2>
              <p class="health-lede">
                Pages that are on the site, with something a reader would miss
                or an editor should know: what conversion left out, and what in
                Drive makes two pages hard to tell apart.
              </p>
              {noteGroups.length === 0 ? (
                <p class="health-empty">
                  Nothing to note: every published page came through conversion
                  whole.
                </p>
              ) : (
                <>
                  <p class="health-empty" data-filter-empty hidden>
                    Nothing here for this filter.
                  </p>
                  <HealthSummaryTable
                    label="Notes, by what to do"
                    unit="Items"
                    rows={noteGroups.map(({ kind, items }) => ({
                      id: `notes-${kind.code}`,
                      title: kind.title,
                      count: items.length,
                      where: whereOf(items),
                      action: kind.action,
                    }))}
                  />
                </>
              )}
              {noteGroups.map(({ kind, items }) => (
                <details
                  class="health-check"
                  id={`notes-${kind.code}`}
                  open={items.length <= OPEN_UP_TO}
                  data-check
                >
                  <summary>
                    <span class="health-check-title">{kind.title}</span>
                    <span class="health-count" data-count>
                      {items.length}
                    </span>
                  </summary>
                  <p class="health-instruction">{kind.instruction}</p>
                  <ul>
                    {items.map((note) => (
                      <li
                        data-section={sectionOf(note)}
                        data-editor={note.lastEditedBy ?? ''}
                      >
                        <div class="health-item-head">
                          {note.slug ? (
                            <a href={`/${note.slug}/`}>{note.name}</a>
                          ) : (
                            <span class="health-item-name">{note.name}</span>
                          )}
                          <a
                            class="health-source"
                            href={note.sourceUrl}
                            rel="noopener noreferrer"
                            target="_blank"
                          >
                            Open in Google Drive
                          </a>
                        </div>
                        <p class="health-meta">
                          {trail(note)} · {note.type}
                          {note.lastEditedBy &&
                            ` · last edited by ${note.lastEditedBy}`}
                        </p>
                        {note.detail && (
                          <p class="health-detail">{note.detail}</p>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              ))}
            </section>
          )}

          {report ? (
            SEVERITIES.map(({ severity, heading, lede, open }) => {
              const inSeverity = groups.filter(
                (group) =>
                  group.check.severity === severity &&
                  group.documents.length > 0,
              );
              return (
                <section class="health-severity" data-severity-section>
                  <h2 id={severity}>{heading}</h2>
                  <p class="health-lede">{lede}</p>
                  {inSeverity.length === 0 ? (
                    <p class="health-empty">Nothing to do here.</p>
                  ) : (
                    <p class="health-empty" data-filter-empty hidden>
                      Nothing here for this filter.
                    </p>
                  )}
                  {inSeverity.length > 0 &&
                    inSeverity.map(({ check, documents: entries }) => (
                      <details class="health-check" open={open} data-check>
                        <summary>
                          <span class="health-check-title">{check.title}</span>
                          <span class="health-count" data-count>
                            {entries.length}
                          </span>
                        </summary>
                        <p class="health-instruction">{check.instruction}</p>
                        <ul>
                          {entries.map(({ document, issues }) => (
                            <li
                              data-section={sectionOf(document)}
                              data-editor={document.lastEditedBy ?? ''}
                            >
                              <div class="health-item-head">
                                <a href={`/${document.slug}/`}>
                                  {document.title}
                                </a>
                                <a
                                  class="health-source"
                                  href={googleDocsUrl(
                                    document.id,
                                    issues.find((issue) => issue.headingId),
                                  )}
                                  rel="noopener noreferrer"
                                  target="_blank"
                                >
                                  Open in Google Docs
                                </a>
                              </div>
                              <p class="health-meta">
                                {trail(document)}
                                {document.lastEditedBy &&
                                  ` · last edited by ${document.lastEditedBy}`}
                              </p>
                              {isFileNameCheck(check.code) && (
                                <p class="health-detail">
                                  Drive name: “{document.name}”
                                </p>
                              )}
                              {issues
                                .filter((issue) => issue.text)
                                .map((issue) => (
                                  <p class="health-detail">
                                    {'Line: '}
                                    {issue.headingId ? (
                                      <a
                                        href={googleDocsUrl(document.id, issue)}
                                        rel="noopener noreferrer"
                                        target="_blank"
                                      >
                                        “{issue.text}”
                                      </a>
                                    ) : (
                                      <span>“{issue.text}”</span>
                                    )}
                                    {issue.detail && ` — ${issue.detail}`}
                                    {issue.related && (
                                      <>
                                        {' — the title of '}
                                        <a href={`/${issue.related.slug}/`}>
                                          {issue.related.title}
                                        </a>
                                      </>
                                    )}
                                  </p>
                                ))}
                            </li>
                          ))}
                        </ul>
                      </details>
                    ))}
                </section>
              );
            })
          ) : (
            <p class="health-notice">
              The next sync writes the title report the checks below this list
              are built from.
            </p>
          )}

          {state && (
            <p class="health-footer">
              How the pages were made:{' '}
              {plural(state.summary.conversion.markdown, 'Google Doc')} from
              Google's Markdown export, {state.summary.conversion.html} through
              its HTML export for images, tables or drawings, and{' '}
              {plural(state.summary.published.pdfs, 'PDF')} published as files
              with their text.
            </p>
          )}
          <p class="health-footer">
            Browse <a href={PLATFORM_ROUTE_HREFS.fullIndex}>all documents</a>.
          </p>
        </>
      )
    }
  </content-health>
</StarlightPage>

<script>
  /**
   * Narrows the list to one section or one editor. Filtering runs in the
   * browser over the rendered list: nothing is fetched, and without script the
   * whole list stays visible.
   */
  class ContentHealth extends HTMLElement {
    connectedCallback() {
      /*
       * A long group starts folded. Following its row in a summary table, or
       * a link to it, opens it.
       */
      const openTarget = (id: string) => {
        const target = id ? document.getElementById(id) : null;
        if (target instanceof HTMLDetailsElement) {
          target.open = true;
        }
      };
      openTarget(decodeURIComponent(location.hash.slice(1)));
      window.addEventListener('hashchange', () =>
        openTarget(decodeURIComponent(location.hash.slice(1))),
      );
      for (const link of this.querySelectorAll<HTMLAnchorElement>(
        '[data-open-group]',
      )) {
        link.addEventListener('click', () =>
          openTarget(decodeURIComponent(link.hash.slice(1))),
        );
      }

      const form = this.querySelector('form');
      const status = this.querySelector<HTMLElement>('[data-status]');
      if (!form || !status) return;
      form.addEventListener('submit', (event) => event.preventDefault());
      form.addEventListener('change', () => this.apply(form, status));
    }

    apply(form: HTMLFormElement, status: HTMLElement) {
      const data = new FormData(form);
      const section = String(data.get('section') ?? '');
      const editor = String(data.get('editor') ?? '');
      const shown = new Set<string>();

      for (const check of this.querySelectorAll<HTMLElement>('[data-check]')) {
        let visible = 0;
        for (const item of check.querySelectorAll<HTMLElement>('li')) {
          const match =
            (!section || item.dataset.section === section) &&
            (!editor || item.dataset.editor === editor);
          item.hidden = !match;
          if (match) {
            visible += 1;
            const link = item.querySelector('a');
            shown.add(link?.getAttribute('href') ?? item.textContent ?? '');
          }
        }
        check.hidden = visible === 0;
        const count = check.querySelector('[data-count]');
        if (count) count.textContent = String(visible);
      }
      for (const note of this.querySelectorAll<HTMLElement>(
        '[data-filter-empty]',
      )) {
        const block = note.closest('[data-severity-section]');
        note.hidden = !!block?.querySelector('[data-check]:not([hidden])');
      }
      status.textContent =
        section || editor
          ? `Showing ${shown.size} items${section ? ` in ${section}` : ''}${editor ? ` last edited by ${editor}` : ''}.`
          : '';
    }
  }

  customElements.define('content-health', ContentHealth);
</script>

<style>
  @layer starlight.components {
    content-health {
      display: block;
    }

    .health-stats {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      margin-block: 1.5rem;
    }

    .health-stats div {
      border: 1px solid var(--kb-hairline);
      border-radius: 0.5rem;
      padding: 0.75rem 1rem;
    }

    .health-stats dt {
      color: var(--kb-gray-3);
      font-size: var(--kb-text-sm);
    }

    .health-stats dd {
      color: var(--kb-ink);
      font-size: var(--kb-text-2xl);
      font-weight: 600;
      margin: 0;
    }

    .health-stats dt a {
      color: inherit;
    }

    .health-stats .health-stat-detail {
      display: block;
      font-size: var(--kb-text-xs);
    }

    .health-stats dd span {
      color: var(--kb-gray-3);
      font-size: var(--kb-text-base);
      font-weight: 400;
    }

    .health-notice,
    .health-lede,
    .health-empty,
    .health-meta,
    .health-filter-status {
      color: var(--kb-gray-3);
      font-size: var(--kb-text-sm);
    }

    .health-filters {
      align-items: end;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-block: 1.5rem;
    }

    .health-filters label {
      display: grid;
      font-size: var(--kb-text-sm);
      gap: 0.25rem;
    }

    .health-filters select {
      background: var(--kb-ground);
      border: 1px solid var(--kb-hairline);
      border-radius: 0.375rem;
      color: var(--kb-ink);
      font: inherit;
      max-width: 100%;
      padding: 0.375rem 0.5rem;
    }

    .health-check {
      border-top: 1px solid var(--kb-hairline);
      padding-block: 0.75rem;
    }

    .health-check summary {
      cursor: pointer;
      display: flex;
      font-weight: 600;
      gap: 0.75rem;
      justify-content: space-between;
    }

    .health-check-title {
      flex: 1;
      text-align: start;
    }

    .health-count {
      color: var(--kb-gray-3);
      font-weight: 400;
    }

    .health-instruction {
      margin-block: 0.5rem 0.75rem;
    }

    .health-check ul {
      list-style: none;
      padding: 0;
    }

    .health-check li {
      border-top: 1px solid var(--kb-hairline);
      padding-block: 0.625rem;
    }

    .health-item-name {
      font-weight: 600;
    }

    .health-item-head {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      justify-content: space-between;
    }

    .health-source {
      font-size: var(--kb-text-sm);
      white-space: nowrap;
    }

    .health-meta,
    .health-detail {
      margin-top: 0.25rem;
    }

    .health-detail {
      font-size: var(--kb-text-sm);
    }
  }
</style>
