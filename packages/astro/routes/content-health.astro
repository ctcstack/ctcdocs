---
/**
 * What editors have to fix, most urgent first, and what is already in order
 * (ADR-024, ADR-025, ADR-037).
 *
 * The page leads with the state of the whole knowledge base: one figure, one
 * bar of every file by its most urgent task, and where the work is, by section
 * and by editor. Below, every group of findings sits under its priority: fix
 * now, fix next, improve, tidy up, and the proposed title convention, which is
 * not required yet. A group is folded to one line saying what it is, what to
 * do, how many files and where; open, it gives the instruction and every file,
 * each with one action: open it in Google Docs or Drive. The checks that found
 * nothing are listed under their priority, so what is in order shows as
 * plainly as what is not.
 *
 * Filters by section and by last editor narrow every task list and count in
 * the browser, and the address keeps them, so a filtered view can be sent to
 * the person it is for. Without script the whole page stays readable. It is
 * rebuilt on every sync, so a fixed task disappears after the next one.
 *
 * It is not in the sidebar and not in search: it is an address people are
 * sent to, not part of the documentation.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import { PLATFORM_ROUTE_HREFS } from '@ctcstack/ctcdocs-core';

import HealthBreakdown from '../components/HealthBreakdown.astro';
import HealthGroup from '../components/HealthGroup.astro';
import { folderAccessFindings, rootFolderId } from '../lib/access-source';
import {
  loadHealthReport,
  loadSyncState,
  sectionOf,
} from '../lib/content-health';
import {
  buildHealthView,
  PRIORITY_LEVELS,
  TASK_PRIORITIES,
  type HealthGroup as Group,
  type Priority,
  type TaskPriority,
} from '../lib/content-health-view';

/**
 * A folder access finding as one line: what it is, and what to do (ADR-039).
 * The fix is always a change to the site configuration, which editors ask the
 * site's maintainers for.
 */
function describeAccess(finding: (typeof folderAccessFindings)[number]): {
  name: string;
  where: string;
  what: string;
} {
  const where = (trail: readonly string[]) =>
    trail.length > 0 ? trail.join(' › ') : 'Top of the Drive';
  switch (finding.code) {
    case 'folder-without-rule':
      return {
        name:
          finding.folder === rootFolderId
            ? 'Documents outside any folder'
            : finding.name,
        where: where(finding.trail),
        what: `No rule: ${plural(finding.documents, 'document')} closed to everyone but the admins until a rule names this folder`,
      };
    case 'rule-group-not-admitted-above':
      return {
        name: finding.name,
        where: where(finding.trail),
        what: `${finding.groups.join(', ')} ${finding.groups.length === 1 ? 'is' : 'are'} not named by a rule above, so ${finding.groups.length === 1 ? 'it admits' : 'they admit'} no one here`,
      };
    case 'rule-folder-missing':
      return {
        name: finding.label,
        where: 'Not in the Drive',
        what: 'A rule names a folder the site does not have: update or remove it',
      };
    case 'rule-label-outdated':
      return {
        name: finding.name,
        where: where(finding.trail),
        what: `The rule still calls it "${finding.label}"`,
      };
  }
}

const report = loadHealthReport();
const state = loadSyncState();
const view = buildHealthView(report, state);

/** A group this long starts folded, even under "Fix now". */
const OPEN_UP_TO = 20;

const ICONS: Record<Priority | 'good', string> = {
  'fix-now': 'error',
  'fix-next': 'warning',
  improve: 'information',
  'tidy-up': 'pencil',
  proposal: 'comment-alt',
  good: 'approve-check-circle',
};
const LABELS = Object.fromEntries(
  PRIORITY_LEVELS.map((level) => [level.id, level.label]),
) as Record<Priority, string>;
/**
 * A file's state by its most urgent task. These name files, not priorities,
 * so the overview's counts never sit under a priority's own label.
 */
const FILE_STATES: Record<TaskPriority | 'good', string> = {
  'fix-now': 'Need a fix now',
  'fix-next': 'Need a fix next',
  improve: 'Only improvements',
  'tidy-up': 'Only tidying',
  good: 'All good',
};
const HEADLINES: Record<TaskPriority, string> = {
  'fix-now': 'to fix now',
  'fix-next': 'to fix next',
  improve: 'to improve',
  'tidy-up': 'to tidy up',
};

const plural = (count: number, one: string, many = `${one}s`) =>
  `${count} ${count === 1 ? one : many}`;
const percent = (part: number, whole: number) =>
  whole > 0 ? Math.round((part / whole) * 100) : 0;

const files = view.files;
/** The most urgent state any file is in, which the figure leads with. */
const lead = files
  ? TASK_PRIORITIES.find((priority) => files.byPriority[priority] > 0)
  : undefined;
const segments = files
  ? [
      ...TASK_PRIORITIES.map((priority) => ({
        id: priority as TaskPriority | 'good',
        count: files.byPriority[priority],
      })),
      { id: 'good' as const, count: files.good },
    ]
  : [];
const tasks = view.tiers
  .filter((tier) => tier.level.id !== 'proposal')
  .reduce((sum, tier) => sum + tier.tasks, 0);
const notOnSite = view.onSite ? view.onSite.total - view.onSite.published : 0;
const hasBreakdown = view.bySection.length + view.byEditor.length > 0;

/**
 * A priority's groups, with the files the site does not show apart from the
 * rest, under a heading each when both are there.
 */
const blocks = (groups: Group[]) => {
  const off = groups.filter((group) => group.source === 'unpublished');
  const on = groups.filter((group) => group.source !== 'unpublished');
  if (off.length === 0 || on.length === 0) {
    return [{ heading: undefined, groups }];
  }
  return [
    { heading: 'Not on the site', groups: off },
    { heading: 'On the site', groups: on },
  ];
};
---

<StarlightPage
  frontmatter={{
    title: 'Content health',
    description:
      'What to fix in Google Docs and Drive, most urgent first, and what is already in order.',
    tableOfContents: false,
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <content-health class="not-content" data-pagefind-ignore>
    {
      !report && !state ? (
        <p class="health-intro">
          The next sync writes the report this page is built from. Check back
          after it has run.
        </p>
      ) : (
        <>
          <p class="health-intro">
            What to fix in Google Docs and Drive, most urgent first. A fixed
            task disappears after the next sync.
          </p>

          {files && (
            <section
              class="health-overview"
              aria-labelledby="health-overview-title"
              data-priority={lead ?? 'good'}
            >
              <p class="health-eyebrow">Whole knowledge base</p>
              <div class="health-hero">
                <Icon name={ICONS[lead ?? 'good']} size="2.25rem" />
                <p class="health-hero-title" id="health-overview-title">
                  {lead ? (
                    <>
                      <span class="health-hero-figure">
                        {files.byPriority[lead]}
                      </span>{' '}
                      {files.byPriority[lead] === 1 ? 'file' : 'files'}{' '}
                      {HEADLINES[lead]}
                    </>
                  ) : (
                    'Everything is in order'
                  )}
                </p>
                {lead && (
                  <a class="health-hero-go" href={`#${lead}`}>
                    Start with these
                    <Icon name="down-arrow" size="1rem" />
                  </a>
                )}
              </div>
              <p class="health-hero-context">
                {view.onSite && (
                  <>
                    {view.onSite.published} of{' '}
                    {plural(view.onSite.total, 'file')} are on the site
                    {notOnSite > 0 ? (
                      <>
                        ; {notOnSite} are not, under{' '}
                        <a href="#fix-next">Fix next</a>.{' '}
                      </>
                    ) : (
                      '. '
                    )}
                  </>
                )}
                {state && (
                  <>
                    As of the sync on{' '}
                    <time datetime={state.generatedAt} data-synced>
                      {state.generatedAt.slice(0, 16).replace('T', ' ')} UTC
                    </time>
                    .
                  </>
                )}
              </p>
              <p class="health-stack-caption">
                {plural(files.total, 'file')} in the published folders, each
                counted once by its most urgent task:
              </p>
              <div
                class="health-stack"
                role="img"
                aria-label={segments
                  .filter((segment) => segment.count > 0)
                  .map(
                    (segment) => `${FILE_STATES[segment.id]}: ${segment.count}`,
                  )
                  .join(', ')}
              >
                {segments
                  .filter((segment) => segment.count > 0)
                  .map((segment) => (
                    <span
                      data-priority={segment.id}
                      style={`--share: ${(segment.count / files.total) * 100}%`}
                      title={`${FILE_STATES[segment.id]}: ${segment.count}`}
                    />
                  ))}
              </div>
              <ul class="health-legend" aria-label="Files by state">
                {segments.map((segment) => (
                  <li data-priority={segment.id}>
                    <span class="health-dot" />
                    <span>{FILE_STATES[segment.id]}</span>
                    <strong>{segment.count}</strong>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {report && report.summary.inspected < report.summary.documents && (
            <p class="health-notice">
              {report.summary.documents - report.summary.inspected} documents
              have not been inspected yet. A full sync inspects every document.
            </p>
          )}

          {hasBreakdown && (
            <details class="health-where" open data-where-block>
              <summary>Where the work is</summary>
              <p class="health-where-lede">
                Tasks in the whole knowledge base, by section and by who last
                edited the file, the most urgent first. Choose a row to see only
                its tasks.
              </p>
              <div class="health-where-lists">
                {view.bySection.length > 0 && (
                  <HealthBreakdown
                    heading="By section"
                    filter="section"
                    rows={view.bySection}
                    labels={LABELS}
                  />
                )}
                {view.byEditor.length > 0 && (
                  <HealthBreakdown
                    heading="By last editor"
                    filter="editor"
                    rows={view.byEditor}
                    labels={LABELS}
                  />
                )}
              </div>
            </details>
          )}

          <form class="health-toolbar" aria-label="Filter the tasks">
            <div class="health-filters">
              <div class="health-filter">
                <label for="health-filter-section">Section</label>
                <select id="health-filter-section" name="section">
                  <option value="">All sections</option>
                  {view.sections.map((section) => (
                    <option value={section}>{section}</option>
                  ))}
                </select>
              </div>
              {view.editors.length > 0 && (
                <div class="health-filter">
                  <label for="health-filter-editor">Last edited by</label>
                  <select id="health-filter-editor" name="editor">
                    <option value="">Anyone</option>
                    {view.editors.map((editor) => (
                      <option value={editor}>{editor}</option>
                    ))}
                  </select>
                </div>
              )}
              <div class="health-filter-actions">
                <button type="reset" data-clear hidden>
                  Clear filters
                </button>
                <button type="button" data-copy hidden>
                  Copy link
                </button>
                <button type="button" data-expand>
                  Expand all
                </button>
              </div>
            </div>
            <nav class="health-jump" aria-label="Priorities">
              <span class="health-jump-label">Jump to:</span>
              <ul>
                {view.tiers.map((tier) => (
                  <li data-priority={tier.level.id}>
                    <a href={`#${tier.level.id}`}>
                      <Icon name={ICONS[tier.level.id]} size="1rem" />
                      {tier.level.id === 'proposal'
                        ? 'Proposal'
                        : tier.level.label}
                      <span
                        class="health-chip-count"
                        data-tier-count={tier.level.id}
                      >
                        {tier.tasks}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <p class="health-filter-status" role="status" data-status>
              {tasks > 0 &&
                files &&
                `${plural(tasks, 'task')} in ${plural(files.total - files.good, 'file')}. A file can have more than one.`}
            </p>
          </form>

          <p
            class="health-all-clear health-filter-clear"
            data-priority="good"
            data-all-clear
            hidden
          >
            <Icon name={ICONS.good} size="1.25rem" />
            Nothing to do for this filter.
          </p>

          {view.tiers.map((tier) => (
            <section
              class="health-tier"
              id={tier.level.id}
              data-priority={tier.level.id}
              data-tier
            >
              <h2>
                <Icon name={ICONS[tier.level.id]} size="1.25rem" />
                <span>{tier.level.label}</span>
                <span class="health-tier-count">
                  <span data-tier-count={tier.level.id}>{tier.tasks}</span>{' '}
                  {tier.tasks === 1 ? 'task' : 'tasks'}
                </span>
              </h2>
              <p class="health-lede">{tier.level.lede}</p>
              {tier.level.id === 'proposal' && view.convention && (
                <div class="health-progress">
                  <div class="health-meter" aria-hidden="true">
                    <span
                      style={`--share: ${percent(view.convention.conforming, view.convention.inspected)}%`}
                    />
                  </div>
                  <p>
                    {view.convention.conforming} of{' '}
                    {plural(view.convention.inspected, 'document')} follow it
                    already.
                  </p>
                </div>
              )}
              {tier.tasks === 0 ? (
                <p class="health-all-clear" data-priority="good">
                  <Icon name={ICONS.good} size="1.25rem" />
                  {tier.level.clear}
                </p>
              ) : (
                <p
                  class="health-all-clear"
                  data-priority="good"
                  data-filter-empty
                  hidden
                >
                  <Icon name={ICONS.good} size="1.25rem" />
                  Nothing at this priority for this filter.
                </p>
              )}
              {blocks(tier.groups).map((block) => (
                <div class="health-block" data-block>
                  {block.heading && (
                    <h3 class="health-block-heading">{block.heading}</h3>
                  )}
                  {block.groups.map((group) => (
                    <HealthGroup
                      group={group}
                      open={
                        tier.level.id === 'fix-now' &&
                        group.entries.length <= OPEN_UP_TO
                      }
                    />
                  ))}
                </div>
              ))}
              {tier.clear.length > 0 && (
                <details class="health-passed" data-priority="good">
                  <summary>
                    <Icon name={ICONS.good} size="1rem" />
                    {tier.tasks === 0
                      ? `All clear on ${plural(tier.clear.length, 'check')}`
                      : `All clear on ${plural(tier.clear.length, 'other check')}`}
                  </summary>
                  <ul>
                    {tier.clear.map((check) => (
                      <li>{check.title}</li>
                    ))}
                  </ul>
                </details>
              )}
            </section>
          ))}

          {folderAccessFindings.length > 0 && (
            <section class="health-tier" id="folder-access" data-tier>
              <h2>
                <span>Folder access</span>
              </h2>
              <p class="health-lede">
                Who may read each folder is set in the site's configuration. A
                folder without a rule is closed to everyone but the admins until
                one is added. Ask whoever maintains the site to change a rule.
              </p>
              <ul class="health-folders">
                {folderAccessFindings.map((finding) => {
                  const line = describeAccess(finding);
                  return (
                    <li
                      data-section={
                        'trail' in finding && finding.folder !== rootFolderId
                          ? (finding.trail[0] ?? finding.name)
                          : 'General'
                      }
                      data-editor=""
                    >
                      <span class="health-folder-name">
                        {finding.code === 'rule-folder-missing' ? (
                          line.name
                        ) : (
                          <a
                            href={`${PLATFORM_ROUTE_HREFS.accessReview}#folder-${finding.folder}`}
                          >
                            {line.name}
                          </a>
                        )}
                      </span>
                      <span class="health-folder-meta">
                        {line.where} · {line.what}
                      </span>
                    </li>
                  );
                })}
              </ul>
              <p class="health-footer">
                The{' '}
                <a href={PLATFORM_ROUTE_HREFS.accessReview}>access review</a>{' '}
                shows who may read every folder.
              </p>
            </section>
          )}

          {view.ignoredFolders.length > 0 && (
            <section class="health-tier" id="left-out" data-tier>
              <h2>
                <span>Left out on purpose</span>
              </h2>
              <p class="health-lede">
                Folders the site is configured to leave out. Nothing in them is
                published. Ask whoever maintains the site if one of them should
                be.
              </p>
              <ul class="health-folders">
                {view.ignoredFolders.map((folder) => (
                  <li data-section={sectionOf(folder)} data-editor="">
                    <span class="health-folder-name">{folder.name}</span>
                    <span class="health-folder-meta">
                      {folder.folderPath.length > 0
                        ? folder.folderPath.join(' › ')
                        : 'General'}{' '}
                      · {plural(folder.items, 'item')}
                    </span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {state && (
            <p class="health-footer">
              How the pages were made:{' '}
              {plural(state.summary.conversion.markdown, 'Google Doc')} from
              Google's Markdown export, {state.summary.conversion.html} through
              its HTML export for images, tables or drawings, and{' '}
              {plural(state.summary.published.pdfs, 'PDF')} published as files
              with their text.
            </p>
          )}
          <p class="health-footer">
            Browse <a href={PLATFORM_ROUTE_HREFS.fullIndex}>all documents</a>.
          </p>
        </>
      )
    }
  </content-health>
</StarlightPage>

<script>
  /**
   * Narrows every task list and count to one section, one editor or both, in
   * the browser over the rendered page: nothing is fetched, and without script
   * the whole page stays visible. The address keeps the filter, so a view can
   * be sent to the person it is for, and a view that short opens its groups.
   */
  import { timeAgo } from '../scripts/time-ago';

  const UNFOLD_UP_TO = 15;
  const NARROW = '(max-width: 50rem)';

  /** As the page writes it: `Handbook 4 · General 1 · +2 more`. */
  function whereOf(sections: string[]): string {
    const counts = new Map<string, number>();
    for (const section of sections) {
      counts.set(section, (counts.get(section) ?? 0) + 1);
    }
    const named = [...counts]
      .sort(
        ([leftName, left], [rightName, right]) =>
          right - left || leftName.localeCompare(rightName, 'en'),
      )
      .map(([name, count]) => `${name} ${count}`);
    return named.length > 2
      ? `${named.slice(0, 2).join(' · ')} · +${named.length - 2} more`
      : named.join(' · ');
  }

  class ContentHealth extends HTMLElement {
    private summary = '';

    connectedCallback() {
      /*
       * A long group starts folded. A link to it, or to anything inside it,
       * opens it.
       */
      const openTarget = (id: string) => {
        const target = id ? document.getElementById(id) : null;
        const group = target?.closest('details');
        if (group) group.open = true;
      };
      openTarget(decodeURIComponent(location.hash.slice(1)));
      window.addEventListener('hashchange', () =>
        openTarget(decodeURIComponent(location.hash.slice(1))),
      );

      const synced = this.querySelector<HTMLTimeElement>('[data-synced]');
      const relative = synced ? timeAgo(synced.dateTime) : '';
      if (synced && relative) synced.textContent += ` (${relative})`;

      this.watchPriorities();

      const form = this.querySelector('form');
      const status = this.querySelector<HTMLElement>('[data-status]');
      if (!form || !status) return;
      this.summary = status.textContent ?? '';

      const params = new URLSearchParams(location.search);
      for (const name of ['section', 'editor']) {
        const select = form.elements.namedItem(name);
        const value = params.get(name);
        if (
          select instanceof HTMLSelectElement &&
          value &&
          [...select.options].some((option) => option.value === value)
        ) {
          select.value = value;
        }
      }

      form.addEventListener('submit', (event) => event.preventDefault());
      form.addEventListener('change', () => this.apply(form, status));
      form.addEventListener('reset', () =>
        setTimeout(() => this.apply(form, status)),
      );

      // A row of "Where the work is" sets its filter and goes to the tasks.
      for (const button of this.querySelectorAll<HTMLButtonElement>(
        '[data-filter-name]',
      )) {
        button.addEventListener('click', () => {
          const select = form.elements.namedItem(
            button.dataset.filterName ?? '',
          );
          if (!(select instanceof HTMLSelectElement)) return;
          select.value =
            select.value === button.dataset.filterValue
              ? ''
              : (button.dataset.filterValue ?? '');
          this.apply(form, status);
          this.firstTier()?.scrollIntoView({ behavior: 'smooth' });
        });
      }

      const expand = this.querySelector<HTMLButtonElement>('[data-expand]');
      expand?.addEventListener('click', () => {
        const groups = this.groups().filter((group) => !group.hidden);
        const open = groups.some((group) => !group.open);
        for (const group of groups) group.open = open;
        this.labelExpand();
      });
      for (const group of this.groups()) {
        group.addEventListener('toggle', () => this.labelExpand());
      }

      const copy = this.querySelector<HTMLButtonElement>('[data-copy]');
      copy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          copy.textContent = 'Link copied';
        } catch {
          copy.textContent = 'Copy the address bar';
        }
        setTimeout(() => (copy.textContent = 'Copy link'), 2000);
      });

      const filtered = this.apply(form, status);
      /*
       * A link to someone's tasks opens on them: past the overview, with the
       * breakdown folded. A phone folds the breakdown anyway.
       */
      const where =
        this.querySelector<HTMLDetailsElement>('[data-where-block]');
      if (where && (filtered || matchMedia(NARROW).matches)) where.open = false;
      if (filtered && !location.hash) {
        form.scrollIntoView({ block: 'start' });
      }
    }

    /** "Expand all" while anything shown is folded, "Collapse all" after. */
    labelExpand() {
      const expand = this.querySelector<HTMLButtonElement>('[data-expand]');
      if (!expand) return;
      const folded = this.groups().some(
        (group) => !group.hidden && !group.open,
      );
      expand.textContent = folded ? 'Expand all' : 'Collapse all';
    }

    groups(): HTMLDetailsElement[] {
      return [...this.querySelectorAll<HTMLDetailsElement>('[data-group]')];
    }

    firstTier(): HTMLElement | null {
      return (
        [...this.querySelectorAll<HTMLElement>('[data-tier]')].find((tier) =>
          tier.querySelector('[data-group]:not([hidden])'),
        ) ?? this.querySelector<HTMLElement>('[data-tier]')
      );
    }

    /** Marks the chip of the priority in view. */
    watchPriorities() {
      const chips = new Map(
        [...this.querySelectorAll<HTMLAnchorElement>('.health-jump a')].map(
          (link) => [link.hash.slice(1), link],
        ),
      );
      if (!('IntersectionObserver' in window) || chips.size === 0) return;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const [id, link] of chips) {
              if (id === entry.target.id) {
                link.setAttribute('aria-current', 'true');
              } else {
                link.removeAttribute('aria-current');
              }
            }
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      for (const tier of this.querySelectorAll('[data-tier]')) {
        observer.observe(tier);
      }
    }

    /** Applies the filter; says whether one is set. */
    apply(form: HTMLFormElement, status: HTMLElement): boolean {
      const data = new FormData(form);
      const section = String(data.get('section') ?? '');
      const editor = String(data.get('editor') ?? '');
      const filtered = !!(section || editor);
      const tiers = new Map<string, number>();
      let shown = 0;

      for (const group of this.groups()) {
        const sections: string[] = [];
        for (const item of group.querySelectorAll<HTMLElement>('li')) {
          const match =
            (!section || item.dataset.section === section) &&
            (!editor || item.dataset.editor === editor);
          item.hidden = !match;
          if (match) sections.push(item.dataset.section ?? '');
        }
        const visible = sections.length;
        group.hidden = visible === 0;
        const count = group.querySelector('[data-count]');
        if (count) count.textContent = String(visible);
        const unit = group.querySelector('[data-count-unit]');
        const name = unit?.closest<HTMLElement>('[data-unit]')?.dataset.unit;
        if (unit && name) unit.textContent = visible === 1 ? name : `${name}s`;
        const where = group.querySelector<HTMLElement>('[data-where]');
        if (where) {
          where.textContent = whereOf(sections);
          where.hidden = !!section;
        }
        const tier = group.dataset.priority ?? '';
        tiers.set(tier, (tiers.get(tier) ?? 0) + visible);
        if (tier !== 'proposal') shown += visible;
      }
      for (const count of this.querySelectorAll<HTMLElement>(
        '[data-tier-count]',
      )) {
        count.textContent = String(
          tiers.get(count.dataset.tierCount ?? '') ?? 0,
        );
      }
      for (const block of this.querySelectorAll<HTMLElement>('[data-block]')) {
        block.hidden = !block.querySelector('[data-group]:not([hidden])');
      }
      for (const folder of this.querySelectorAll<HTMLElement>(
        '.health-folders li',
      )) {
        folder.hidden =
          !!editor || (!!section && folder.dataset.section !== section);
      }
      for (const note of this.querySelectorAll<HTMLElement>(
        '[data-filter-empty]',
      )) {
        const tier = note.closest<HTMLElement>('[data-tier]');
        note.hidden =
          !filtered || !!tier?.querySelector('[data-group]:not([hidden])');
        tier?.toggleAttribute('data-emptied', !note.hidden);
      }
      const empty = filtered && shown === 0;
      const allClear = this.querySelector<HTMLElement>('[data-all-clear]');
      if (allClear) allClear.hidden = !empty;
      if (empty) {
        for (const note of this.querySelectorAll<HTMLElement>(
          '[data-filter-empty]',
        )) {
          note.hidden = true;
        }
      }

      /*
       * A short list opens; the whole list goes back to how the page was
       * built.
       */
      for (const group of this.groups()) {
        if (!filtered) group.open = group.hasAttribute('data-default-open');
        else if (shown <= UNFOLD_UP_TO && !group.hidden) group.open = true;
      }

      for (const button of this.querySelectorAll<HTMLButtonElement>(
        '[data-filter-name]',
      )) {
        const value =
          button.dataset.filterName === 'section' ? section : editor;
        button.setAttribute(
          'aria-pressed',
          String(value === button.dataset.filterValue),
        );
      }
      for (const [selector, hidden] of [
        ['[data-clear]', !filtered],
        ['[data-copy]', !filtered || !navigator.clipboard],
      ] as const) {
        const button = form.querySelector<HTMLElement>(selector);
        if (button) button.hidden = hidden;
      }
      status.textContent = filtered
        ? `Showing ${shown} ${shown === 1 ? 'task' : 'tasks'}${section ? ` in ${section}` : ''}${editor ? ` last edited by ${editor}` : ''}, the proposal aside. The overview above stays the whole knowledge base.`
        : this.summary;

      this.labelExpand();

      const url = new URL(location.href);
      for (const [name, value] of [
        ['section', section],
        ['editor', editor],
      ] as const) {
        if (value) url.searchParams.set(name, value);
        else url.searchParams.delete(name);
      }
      if (url.href !== location.href) {
        history.replaceState(history.state, '', url);
      }
      return filtered;
    }
  }

  customElements.define('content-health', ContentHealth);
</script>

