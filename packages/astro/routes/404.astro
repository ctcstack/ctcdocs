---
/**
 * The page a missing address lands on, and a way back from it.
 *
 * While addresses follow names (ADR-021), an address copied from the browser
 * lasts until its page is renamed twice. The page it named usually still
 * exists under another address, and its name is still in the one that was
 * requested. So this page searches for it: `/sales/pricing-2025/` looks for
 * "pricing 2025", and the document is usually the first result (ADR-032).
 *
 * Nothing is stored for this: the search runs in the browser against the
 * index every page already uses. A permanent link, `/d/<short ID>/`, carries
 * no words, and the page says so instead of searching.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { PLATFORM_ROUTE_HREFS } from '@ctcstack/ctcdocs-core';
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description: 'No page is published at this address.',
    tableOfContents: false,
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <missing-page data-pagefind-ignore>
    <p>
      Nothing is published at this address. Pages move when their documents are
      renamed or moved in Drive; the permanent link a page offers does not.
    </p>
    <section aria-labelledby="missing-page-results" hidden data-results>
      <h2 id="missing-page-results">Perhaps you were looking for</h2>
      <ol data-result-list></ol>
    </section>
    <p>
      Browse <a href={PLATFORM_ROUTE_HREFS.fullIndex}>all documents</a> or search
      from the top of the page.
    </p>
  </missing-page>
</StarlightPage>

<script>
  import { searchesFor } from '../scripts/missing-page-searches';
  import { readableBundles } from '../scripts/search-bundles';

  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string };
  }

  interface Pagefind {
    mergeIndex(bundlePath: string): Promise<void>;
    search(term: string): Promise<{
      results: Array<{ data(): Promise<PagefindResultData> }>;
    }>;
  }

  class MissingPage extends HTMLElement {
    async connectedCallback() {
      const section = this.querySelector<HTMLElement>('[data-results]');
      const list = this.querySelector<HTMLOListElement>('[data-result-list]');
      const searches = searchesFor(window.location.pathname);
      if (!section || !list || searches.length === 0) return;

      try {
        const bundle = '/pagefind/pagefind.js';
        const pagefind = (await import(/* @vite-ignore */ bundle)) as Pagefind;
        // The bundles of the reader's other access classes (ADR-039).
        for (const extra of await readableBundles()) {
          await pagefind.mergeIndex(extra);
        }
        let results: PagefindResultData[] = [];
        for (const terms of searches) {
          const search = await pagefind.search(terms);
          results = await Promise.all(
            search.results.slice(0, 5).map((result) => result.data()),
          );
          if (results.length > 0) break;
        }
        for (const result of results) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = result.url;
          link.textContent = result.meta.title ?? result.url;
          const excerpt = document.createElement('p');
          // The excerpt marks matches with HTML; only its text is shown.
          excerpt.textContent =
            new DOMParser().parseFromString(result.excerpt, 'text/html').body
              .textContent ?? '';
          item.append(link, excerpt);
          list.append(item);
        }
        section.hidden = results.length === 0;
      } catch {
        // Without the index the page still says what happened and where to go.
      }
    }
  }

  customElements.define('missing-page', MissingPage);
</script>

<style>
  /*
   * The results are created by the script above, after Astro scoped the
   * stylesheet to the markup it rendered, so their selectors are global.
   */
  @layer starlight.components {
    missing-page {
      display: block;
    }

    missing-page :global(ol) {
      list-style: none;
      padding: 0;
    }

    missing-page :global(li) {
      padding-block: 0.75rem;
    }

    missing-page :global(li + li) {
      border-top: 1px solid var(--kb-hairline);
    }

    missing-page :global(li p) {
      color: var(--kb-gray-3);
      font-size: var(--kb-text-sm);
      margin-top: 0.25rem;
    }
  }
</style>
